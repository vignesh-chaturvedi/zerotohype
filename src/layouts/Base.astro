---
import "@fontsource/schibsted-grotesk/500.css";
import "@fontsource/schibsted-grotesk/600.css";
import "@fontsource/schibsted-grotesk/700.css";
import "@fontsource/public-sans/400.css";
import "@fontsource/public-sans/400-italic.css";
import "@fontsource/public-sans/600.css";
import "@fontsource/martian-mono/400.css";
import "@fontsource/martian-mono/500.css";
import "../styles/global.css";
// The body and heading faces are on every page above the fold, so they are fetched before the CSS asks.
import bodyFont from "@fontsource/public-sans/files/public-sans-latin-400-normal.woff2?url";
import headingFont from "@fontsource/schibsted-grotesk/files/schibsted-grotesk-latin-600-normal.woff2?url";
import settlements from "../../public/data/hip4-settlements.json";
import { trackLook } from "../lib/track-look";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
// Each page's share card is drawn after the build by scripts/og-cards.mjs, named after the page's path.
const ogSlug = Astro.url.pathname.replace(/^\/|\/$/g, "").replace(/\//g, "-") || "home";
const ogImage = new URL(`/og/${ogSlug === "404" ? "home" : ogSlug}.png`, Astro.site).href;
const fullTitle = title === "Zero to HYPE" ? title : `${title} · Zero to HYPE`;
const path = Astro.url.pathname;
const nav = [
  { href: "/", label: "Roadmap", match: (p: string) => p === "/" || p.startsWith("/tracks/") },
  { href: "/labs/", label: "Labs", match: (p: string) => p.startsWith("/labs/") },
  { href: "/changelog/", label: "Changelog", match: (p: string) => p.startsWith("/changelog/") },
  { href: "/about/", label: "About", match: (p: string) => p.startsWith("/about/") },
];
const repo = "https://github.com/vignesh-chaturvedi/zerotohype";
const marketCount = settlements.markets.length;
const stripColors = Object.values(trackLook).map((l) => l.color);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(path, Astro.site).href} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title}: a card from Zero to HYPE`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#0c0c0b" />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={headingFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>
      // A theme the reader picked wins; otherwise the site follows the system's light or dark setting,
      // and is dark when there is none. Applied before the page paints.
      (() => {
        let saved = null;
        try { saved = localStorage.getItem("theme"); } catch {}
        const light = saved === "light" || saved === "dark" ? saved === "light" : matchMedia("(prefers-color-scheme: light)").matches;
        if (light) document.documentElement.dataset.theme = "light";
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <a class="livebar" href="/labs/settlement/">
      <span class="flag">New</span>
      <span class="livebar-text">Settlement explorer: replay {marketCount} real HIP-4 settlements</span>
      <span aria-hidden="true">→</span>
    </a>
    <header class="site">
      <div class="wrap bar">
        <a class="brand" href="/" aria-label="Zero to HYPE, home">
          <svg class="glyph" viewBox="0 0 28 28" aria-hidden="true">
            <rect width="28" height="28" rx="8" />
            <ellipse cx="11.6" cy="15.4" rx="4.6" ry="6.2" class="g-zero" />
            <path d="M17 11 L22.2 5.8 M18 5.8 H22.2 V10" class="g-arrow" />
          </svg>
          <span class="word">Zero to <span class="hype">HYPE</span></span>
        </a>
        <nav aria-label="Site">
          {nav.map((item) => (
            <a href={item.href} aria-current={item.match(path) ? "page" : undefined}>{item.label}</a>
          ))}
        </nav>
        <div class="actions">
          <button class="search-btn" type="button" data-search-open aria-keyshortcuts="Meta+K Control+K /">
            <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.6" cy="8.6" r="5.6" /><path d="m13 13 4.2 4.2" /></svg>
            <span class="search-word">Search</span>
            <kbd aria-hidden="true">⌘K</kbd>
          </button>
          <button class="theme-toggle" type="button" id="theme-toggle" aria-label="Switch to dark mode" title="Switch to dark mode">
            <svg class="i-moon" viewBox="0 0 20 20" aria-hidden="true"><path d="M16.5 12.3A7 7 0 0 1 7.7 3.5a7 7 0 1 0 8.8 8.8Z" /></svg>
            <svg class="i-sun" viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="3.6" /><path d="M10 1.8v2.1M10 16.1v2.1M1.8 10h2.1M16.1 10h2.1M4.2 4.2l1.5 1.5M14.3 14.3l1.5 1.5M4.2 15.8l1.5-1.5M14.3 5.7l1.5-1.5" /></svg>
          </button>
          <a class="gh" href={repo} aria-label="Source on GitHub">
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" /></svg>
            <span>GitHub</span>
          </a>
          <a class="start" href="/tracks/t01-orientation/">Start <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </header>
    <slot name="stage" />
    <main id="main" class="wrap page">
      <slot />
    </main>
    <dialog id="search" class="search" aria-label="Search the site">
      <form method="dialog" class="search-bar" role="search" onsubmit="return false">
        <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.6" cy="8.6" r="5.6" /><path d="m13 13 4.2 4.2" /></svg>
        <input type="search" placeholder="Search tracks, labs and the changelog" autocomplete="off" spellcheck="false" aria-label="Search" aria-controls="search-results" />
        <button type="button" class="esc" onclick="this.closest('dialog').close()">Esc</button>
      </form>
      <div id="search-results" class="search-results" role="listbox" aria-label="Results"></div>
      <p class="search-foot"><span><kbd>↑</kbd><kbd>↓</kbd> move <kbd>↵</kbd> open</span><span>Runs in your browser</span></p>
    </dialog>
    <footer class="site-foot">
      <div class="wrap foot">
        <div class="foot-brand">
          <p class="foot-mark">Zero to <span>HYPE</span></p>
          <p class="foot-note">A free, open-source field guide for building on Hyperliquid. No sign-up, no paywall.</p>
        </div>
        <div class="foot-cols">
          <div>
            <p class="eyebrow">Learn</p>
            <a href="/">Roadmap</a>
            <a href="/labs/">Labs</a>
            <a href="/changelog/">API changelog</a>
          </div>
          <div>
            <p class="eyebrow">Project</p>
            <a href="/about/">About</a>
            <a href={repo}>Source on GitHub</a>
            <a href={`${repo}/issues`}>Report a mistake</a>
          </div>
        </div>
        <p class="legal">
          Independent and not affiliated with Hyperliquid. Code under MIT, content under CC BY 4.0.
          Facts are checked against the live API, and each lesson shows when.
        </p>
      </div>
      <div class="strip" aria-hidden="true">{stripColors.map((c) => <span style={`--c: ${c}`} />)}</div>
      <p class="bleed" aria-hidden="true">Zero to <span>HYPE</span></p>
    </footer>
    <script>
      import "../scripts/diagram-motion.ts";
      import "../scripts/search.ts";
      import "../scripts/progress.ts";
      import "../scripts/freshness.ts";

      // Light/dark switch: flips whatever is showing now and remembers the choice.
      const root = document.documentElement;
      const toggle = document.getElementById("theme-toggle");
      const current = () => (root.dataset.theme === "light" ? "light" : "dark");
      const label = () => {
        const next = current() === "dark" ? "light" : "dark";
        toggle?.setAttribute("aria-label", `Switch to ${next} mode`);
        toggle?.setAttribute("title", `Switch to ${next} mode`);
        const bg = getComputedStyle(root).getPropertyValue("--bg").trim();
        document.querySelectorAll('meta[name="theme-color"]').forEach((m) => m.setAttribute("content", bg));
      };
      toggle?.addEventListener("click", () => {
        const next = current() === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        try { localStorage.setItem("theme", next); } catch {}
        label();
      });
      // Until the reader picks a theme, follow the system when it switches between light and dark.
      matchMedia("(prefers-color-scheme: light)").addEventListener("change", (e) => {
        let saved = null;
        try { saved = localStorage.getItem("theme"); } catch {}
        if (saved === "light" || saved === "dark") return;
        if (e.matches) root.dataset.theme = "light";
        else delete root.dataset.theme;
        label();
      });
      label();
    </script>
  </body>
</html>

<style>
  .skip { position: absolute; left: 12px; top: -60px; z-index: 30; padding: 10px 14px; border-radius: 8px; background: var(--primary); color: var(--on-primary); }
  .skip:focus { top: 12px; }

  .livebar {
    display: flex; align-items: center; justify-content: center; gap: 12px; flex-wrap: wrap;
    padding: 7px max(20px, env(safe-area-inset-right, 0px)) 7px max(20px, env(safe-area-inset-left, 0px));
    background: var(--bg); color: var(--ink-2); text-decoration: none; font: 400 0.75rem/1.5 var(--data); letter-spacing: 0.02em; text-align: center;
    border-bottom: 1px solid var(--rule);
  }
  .livebar:hover .livebar-text { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 560px) {
    .livebar { flex-wrap: nowrap; justify-content: flex-start; font-size: 0.75rem; }
    .livebar-text { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  }
  .flag { display: inline-flex; align-items: center; font: 500 0.75rem/1 var(--data); letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); }

  header.site {
    position: sticky; top: 0; z-index: 20;
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    /* The prefixed line must come first: the minifier keeps only the last of the pair, and Chrome and Firefox ignore the prefix. */
    -webkit-backdrop-filter: saturate(1.3) blur(14px);
    backdrop-filter: saturate(1.3) blur(14px);
    border-bottom: 1px solid var(--rule);
  }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    header.site { background: var(--bg); }
  }
  .bar { display: flex; align-items: center; gap: 12px 26px; padding-block: 12px; flex-wrap: wrap; }
  .brand { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; color: var(--ink); }
  .glyph { width: 28px; height: 28px; flex: none; }
  .glyph rect { fill: var(--primary); }
  .g-zero { fill: none; stroke: var(--on-primary); stroke-width: 2.4; }
  .g-arrow { fill: none; stroke: var(--accent); stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
  .word { font: 600 1.08rem/1 var(--display); letter-spacing: -0.02em; }
  /* "HYPE" in orange mono, as in the footer, the big wordmark and the share cards. */
  .hype { font: 500 0.85em/1 var(--data); letter-spacing: 0.02em; margin-left: 2px; color: var(--accent); }
  nav { display: flex; gap: 4px; flex-wrap: wrap; }
  nav a { position: relative; font-size: 0.90625rem; color: var(--muted); text-decoration: none; padding: 7px 10px; transition: color 150ms var(--ease); }
  nav a:hover { color: var(--ink); }
  nav a[aria-current="page"] { color: var(--ink); }
  nav a[aria-current="page"]::after { content: ""; position: absolute; left: 10px; right: 10px; bottom: -13px; height: 2px; background: var(--accent); }
  .actions { margin-left: auto; display: flex; gap: 8px; align-items: center; }
  .search-btn, .theme-toggle, .gh {
    display: inline-flex; align-items: center; gap: 8px; height: 36px; padding: 0 12px; border-radius: 8px; cursor: pointer;
    font: 500 0.875rem/1 var(--body); color: var(--ink-2); background: transparent; border: 1px solid var(--rule-strong); text-decoration: none;
    transition: border-color 150ms var(--ease), color 150ms var(--ease);
  }
  .search-btn:hover, .theme-toggle:hover, .gh:hover { border-color: var(--ink); color: var(--ink); }
  .search-btn { min-width: 168px; color: var(--muted); }
  .search-btn svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; }
  .search-btn kbd { margin-left: auto; font: 500 0.75rem/1 var(--data); padding: 4px 6px; border-radius: 4px; border: 1px solid var(--rule-strong); color: var(--muted); }
  .theme-toggle { width: 38px; padding: 0; justify-content: center; color: var(--ink); }
  .theme-toggle svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .theme-toggle .i-moon { fill: currentColor; stroke: none; }
  .gh { color: var(--ink); font-weight: 600; }
  .gh svg { width: 15px; height: 15px; fill: currentColor; }
  .start { display: inline-flex; align-items: center; gap: 7px; height: 36px; padding: 0 14px; font: 600 0.875rem/1 var(--body); text-decoration: none; border-radius: 8px; color: var(--on-primary); background: var(--primary); }
  .start:hover { box-shadow: var(--shadow); }
  @media (max-width: 1060px) { .search-btn { min-width: 0; } .search-btn kbd { display: none; } }
  @media (max-width: 760px) {
    .bar { gap: 10px; }
    nav { order: 3; width: 100%; margin-inline: -10px; }
    nav a { padding: 6px 10px; }
    nav a[aria-current="page"]::after { bottom: -9px; }
    .gh { display: none; }
    /* Hidden from sight but not from screen readers: it is the search button's name. */
    .search-word { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .search-btn { width: 38px; padding: 0; justify-content: center; }
  }

  .page { padding-block: 56px 96px; display: grid; grid-template-columns: minmax(0, 1fr); gap: 72px; }

  .site-foot { position: relative; overflow: hidden; border-top: 1px solid var(--rule); background: var(--bg); }
  .foot { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 32px 48px; padding-block: 56px 28px; }
  .foot-brand { display: grid; gap: 10px; align-content: start; }
  .foot-mark { font: 600 1.25rem/1 var(--display); letter-spacing: -0.02em; }
  .foot-mark span { font: 400 0.85em/1 var(--data); color: var(--accent); }
  .foot-note { color: var(--muted); max-width: 44ch; }
  .foot-cols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .foot-cols div { display: grid; gap: 8px; align-content: start; }
  .foot-cols a { color: var(--ink-2); text-decoration: none; font-size: 0.9375rem; }
  .foot-cols a:hover { color: var(--accent); }
  .legal { grid-column: 1 / -1; padding-top: 20px; border-top: 1px solid var(--rule); font-size: 0.8125rem; color: var(--muted); max-width: 90ch; }
  .strip { display: flex; height: 4px; }
  .strip span { flex: 1; background: color-mix(in srgb, var(--c) 85%, var(--bg)); }
  .bleed {
    margin: 0; padding-inline: max(12px, env(safe-area-inset-left, 0px)); white-space: nowrap; text-align: center;
    font: 600 clamp(3.4rem, 16vw, 15rem)/0.9 var(--display); letter-spacing: -0.065em; color: var(--ink);
    padding-block: 0.08em 0.1em; user-select: none;
  }
  .bleed span { font: 400 0.86em/0.9 var(--data); letter-spacing: -0.11em; color: var(--accent); }
  @media (max-width: 760px) { .foot { grid-template-columns: minmax(0, 1fr); } }
</style>
