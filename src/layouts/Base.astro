---
import "@fontsource/overpass/400.css";
import "@fontsource/overpass/400-italic.css";
import "@fontsource/overpass/600.css";
import "@fontsource/overpass/700.css";
import "@fontsource/overpass/800.css";
import "@fontsource/overpass/900.css";
import "@fontsource/overpass-mono/400.css";
import "@fontsource/overpass-mono/600.css";
import "../styles/global.css";
// The body face and the heavy face of the headings and the logo are on every page above the fold, so
// they are fetched before the CSS asks.
import bodyFont from "@fontsource/overpass/files/overpass-latin-400-normal.woff2?url";
import headingFont from "@fontsource/overpass/files/overpass-latin-900-normal.woff2?url";
import { getCollection } from "astro:content";
import settlements from "../../public/data/hip4-settlements.json";
import { trackLook } from "../lib/track-look";
import { author, breadcrumbs, cardUrl, jsonLd, website, type Node } from "../lib/structured-data";

interface Props {
  /** The page's title, in the words people search for; " · Zero to HYPE" follows unless it starts with the name. */
  title: string;
  description: string;
  /** The page's heading, which its share card shows, so the card's alt text names it (default: the title). */
  heading?: string;
  /** Where the page sits below the homepage, as [name, path] pairs ending with the page itself. */
  trail?: [string, string][];
  /** What the page is, for search engines (src/lib/structured-data.ts). */
  data?: Node[];
  /** When an article's facts were last checked: it's shared as an article modified then. */
  modified?: Date;
  /** A Markdown version of the page, for pasting into an assistant. */
  markdown?: string;
  /** Keeps the page out of search results. */
  noindex?: boolean;
}

const { title, description, heading = title, trail, data = [], modified, markdown, noindex = false } = Astro.props;
// The tracks in order, as "id:code" pairs, so the header's Start link can become "Continue T4" (progress.ts).
const trackOrder = (await getCollection("tracks")).sort((a, b) => a.data.order - b.data.order).map((t) => `${t.id}:${t.data.code}`).join(",");
const path = Astro.url.pathname;
// Each page's share card is drawn after the build by scripts/og-cards.mjs, named after the page's path.
// It shows the page's heading and description, so its alt text says the same.
const ogImage = cardUrl(path);
const imageAlt = `Card from Zero to HYPE: “${heading}”. ${description}`;
const fullTitle = title.startsWith("Zero to HYPE") ? title : `${title} · Zero to HYPE`;
// The site and its author on every page, where the page sits, and what it is.
const graph = jsonLd([website, author, ...(trail ? [breadcrumbs(trail)] : []), ...data]);
const nav = [
  { href: "/", label: "Roadmap", match: (p: string) => p === "/" || p.startsWith("/tracks/") },
  { href: "/labs/", label: "Labs", match: (p: string) => p.startsWith("/labs/") },
  { href: "/changelog/", label: "Changelog", match: (p: string) => p.startsWith("/changelog/") },
  { href: "/about/", label: "About", match: (p: string) => p.startsWith("/about/") },
];
const repo = "https://github.com/vignesh-chaturvedi/zerotohype";
const marketCount = settlements.markets.length;
const lines = Object.entries(trackLook).map(([code, l]) => ({ code, color: l.color }));
// The wordmark beside the logo's zero, one letter at a time so the letters can roll in and out.
const word = [..."to HYPE"];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content="Zero to HYPE" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={modified ? "article" : "website"} />
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    <meta property="og:url" content={new URL(path, Astro.site).href} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@vitwts" />
    <meta name="twitter:creator" content="@vitwts" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <meta name="theme-color" content="#000000" />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={headingFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Hyperliquid API changelog (Zero to HYPE)" href="/changelog/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title="New and re-checked lessons (Zero to HYPE)" href="/tracks/rss.xml" />
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} />}
    <script type="application/ld+json" is:inline set:html={graph} />
    <script is:inline>
      // A theme the reader picked wins; otherwise the site follows the system's light or dark setting,
      // and is dark when there is none. Applied before the page paints.
      (() => {
        let saved = null;
        try { saved = localStorage.getItem("theme"); } catch {}
        const light = saved === "light" || saved === "dark" ? saved === "light" : matchMedia("(prefers-color-scheme: light)").matches;
        if (light) document.documentElement.dataset.theme = "light";
        // Motion the reader paused stays paused (motion.ts).
        try { if (localStorage.getItem("zth:motion") === "paused") document.documentElement.dataset.motion = "paused"; } catch {}
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <aside aria-label="What's new">
      <a class="livebar" href="/labs/settlement/">
        <span class="flag">New</span>
        <span class="livebar-text">Settlement explorer: replay {marketCount} real HIP-4 settlements</span>
        <span aria-hidden="true">→</span>
      </a>
    </aside>
    <header class="site" data-site-head>
      <div class="wrap bar">
        {/* The logo: a traffic-yellow route disc with a slashed zero, and the rest of the name beside it.
            Scrolled down, the letters roll back into the disc and it spins shut, leaving the disc alone;
            back at the top it rolls them out again (Base.astro's script, the [data-short] rules below). */}
        <a class="brand" href="/" aria-label="Zero to HYPE, home">
          <svg class="disc" viewBox="0 0 32 32" aria-hidden="true">
            <circle cx="16" cy="16" r="16" class="disc-face" />
            <g class="disc-zero">
              <ellipse cx="16" cy="16" rx="6.1" ry="9.1" />
              <path d="M12.6 23.2 19.4 8.8" />
            </g>
          </svg>
          <span class="word" aria-hidden="true">
            <span class="word-clip">
              <span class="word-in">
                {word.map((ch, i) => (
                  <span class={`ch${ch === " " ? " gap" : ""}${i >= 3 ? " big" : ""}`} style={`--i: ${i}; --r: ${word.length - 1 - i}`}>{ch === " " ? " " : ch}</span>
                ))}
              </span>
            </span>
          </span>
        </a>
        <nav aria-label="Site">
          {nav.map((item) => (
            <a href={item.href} aria-current={item.match(path) ? "page" : undefined}>{item.label}</a>
          ))}
        </nav>
        <div class="actions">
          <button class="search-btn" type="button" data-search-open aria-keyshortcuts="Meta+K Control+K /">
            <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.6" cy="8.6" r="5.6" /><path d="m13 13 4.2 4.2" /></svg>
            <span class="search-word">Search</span>
            <kbd aria-hidden="true">⌘K</kbd>
          </button>
          <button class="theme-toggle" type="button" id="theme-toggle" aria-label="Switch to dark mode" title="Switch to dark mode">
            <svg class="i-moon" viewBox="0 0 20 20" aria-hidden="true"><path d="M16.5 12.3A7 7 0 0 1 7.7 3.5a7 7 0 1 0 8.8 8.8Z" /></svg>
            <svg class="i-sun" viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="3.6" /><path d="M10 1.8v2.1M10 16.1v2.1M1.8 10h2.1M16.1 10h2.1M4.2 4.2l1.5 1.5M14.3 14.3l1.5 1.5M4.2 15.8l1.5-1.5M14.3 5.7l1.5-1.5" /></svg>
          </button>
          <a class="gh" href={repo} aria-label="Source on GitHub">
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" /></svg>
            <span>GitHub</span>
          </a>
          <a class="start" href="/tracks/t01-orientation/" data-tracks={trackOrder}><span data-start-label>Start</span> <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </header>
    <main id="main">
      <slot name="stage" />
      <div class="wrap page">
        <slot />
      </div>
    </main>
    <dialog id="search" class="search" aria-label="Search the site">
      <form method="dialog" class="search-bar" role="search" onsubmit="return false">
        <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.6" cy="8.6" r="5.6" /><path d="m13 13 4.2 4.2" /></svg>
        <input type="search" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="search-results" placeholder="Search tracks, labs and the changelog" autocomplete="off" spellcheck="false" aria-label="Search" />
        <button type="button" class="esc" aria-label="Close search (Esc)" onclick="this.closest('dialog').close()">Esc</button>
      </form>
      <div id="search-results" class="search-results"></div>
      <p class="visually-hidden" role="status" id="search-status"></p>
      <p class="search-foot"><span><kbd>↑</kbd><kbd>↓</kbd> move <kbd>↵</kbd> open</span><span>Runs in your browser</span></p>
    </dialog>
    <footer class="site-foot">
      {/* The ten lines, end to end: the whole roadmap as one strip. */}
      <ol class="route" aria-hidden="true">
        {lines.map((l) => <li style={`--c: ${l.color}`}><span>{l.code}</span></li>)}
      </ol>
      <div class="wrap foot">
        <div class="foot-brand">
          <p class="foot-mark">
            <svg class="disc" viewBox="0 0 32 32" aria-hidden="true">
              <circle cx="16" cy="16" r="16" class="disc-face" />
              <g class="disc-zero"><ellipse cx="16" cy="16" rx="6.1" ry="9.1" /><path d="M12.6 23.2 19.4 8.8" /></g>
            </svg>
            <span>Zero to HYPE</span>
          </p>
          <p class="foot-note">A free, open-source field guide for building on Hyperliquid. No sign-up, no paywall.</p>
        </div>
        <div class="foot-cols">
          <div>
            <p class="eyebrow">Learn</p>
            <a href="/">Roadmap</a>
            <a href="/labs/">Labs</a>
            <a href="/changelog/">API changelog</a>
            <a href="/errors/">API errors</a>
            <a href="/glossary/">Glossary</a>
          </div>
          <div>
            <p class="eyebrow">Project</p>
            <a href="/about/">About</a>
            <a href={repo}>Source on GitHub</a>
            <a href={`${repo}/issues`}>Report a mistake</a>
          </div>
        </div>
        <p class="legal">
          Independent and not affiliated with Hyperliquid. Code under MIT, content under CC BY 4.0.
          Facts are checked against the live API, and each lesson shows when.
        </p>
      </div>
    </footer>
    <script>
      import "../scripts/diagram-motion.ts";
      import "../scripts/search.ts";
      import "../scripts/progress.ts";
      import "../scripts/freshness.ts";
      import "../scripts/scroll-areas.ts";

      // Light/dark switch: flips whatever is showing now and remembers the choice.
      const root = document.documentElement;
      const toggle = document.getElementById("theme-toggle");
      const current = () => (root.dataset.theme === "light" ? "light" : "dark");
      const label = () => {
        const next = current() === "dark" ? "light" : "dark";
        toggle?.setAttribute("aria-label", `Switch to ${next} mode`);
        toggle?.setAttribute("title", `Switch to ${next} mode`);
        // The browser's own bar matches the header band.
        const band = getComputedStyle(root).getPropertyValue("--band").trim();
        document.querySelectorAll('meta[name="theme-color"]').forEach((m) => m.setAttribute("content", band));
      };
      toggle?.addEventListener("click", () => {
        const next = current() === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        try { localStorage.setItem("theme", next); } catch {}
        label();
      });
      // Until the reader picks a theme, follow the system when it switches between light and dark.
      matchMedia("(prefers-color-scheme: light)").addEventListener("change", (e) => {
        let saved = null;
        try { saved = localStorage.getItem("theme"); } catch {}
        if (saved === "light" || saved === "dark") return;
        if (e.matches) root.dataset.theme = "light";
        else delete root.dataset.theme;
        label();
      });
      label();

      // The logo is the whole name at the top of the page and just the disc once the page has scrolled
      // (the idea of tradl.ai's header, whose wordmark folds to its first letter). The first state is set
      // without animating, so a page opened halfway down doesn't roll its logo up on arrival.
      const head = document.querySelector<HTMLElement>("[data-site-head]");
      if (head) {
        let short: boolean | null = null;
        const fold = () => {
          const next = scrollY > 24;
          if (next === short) return;
          short = next;
          head.toggleAttribute("data-short", next);
        };
        head.classList.add("still");
        fold();
        requestAnimationFrame(() => requestAnimationFrame(() => head.classList.remove("still")));
        addEventListener("scroll", fold, { passive: true });
      }
    </script>
  </body>
</html>

<style>
  .skip { position: absolute; left: 12px; top: -60px; z-index: 30; padding: 12px 14px 10px; border-radius: var(--r); background: var(--signal); color: var(--on-signal); font-weight: 800; }
  .skip:focus { top: 12px; }

  /* What's new: a service notice, black on traffic yellow. */
  .livebar {
    display: flex; align-items: center; justify-content: center; gap: 12px; flex-wrap: wrap;
    padding: 8px max(20px, env(safe-area-inset-right, 0px)) 6px max(20px, env(safe-area-inset-left, 0px));
    background: var(--signal); color: var(--on-signal); text-decoration: none; font: 700 0.84375rem/1.4 var(--body); text-align: center;
  }
  .livebar:hover .livebar-text { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 3px; }
  .livebar:focus-visible { outline-color: var(--on-signal); outline-offset: -4px; }
  /* On phones the text wraps to a second line instead of being cut off. */
  @media (max-width: 560px) {
    .livebar { flex-wrap: nowrap; justify-content: flex-start; text-align: left; }
    .livebar-text { min-width: 0; }
  }
  .flag { display: inline-flex; align-items: center; padding: 4px 6px 2px; border-radius: 2px; background: var(--on-signal); color: var(--signal); font: 900 0.6875rem/1 var(--body); letter-spacing: 0.1em; text-transform: uppercase; flex: none; }

  /* The header is a sign band: white on black in both themes. */
  header.site { position: sticky; top: 0; z-index: 20; background: var(--band); color: var(--on-band); border-bottom: 1px solid var(--band-rule); }
  .bar { display: flex; align-items: center; gap: 8px 22px; min-height: 59px; padding-block: 8px; flex-wrap: wrap; }
  .brand { display: inline-flex; align-items: center; height: 44px; color: var(--on-band); text-decoration: none; border-radius: 2px; }
  .brand:focus-visible { outline-color: var(--signal); outline-offset: 4px; }
  .disc { width: 34px; height: 34px; flex: none; overflow: visible; }
  .disc-face { fill: var(--signal); }
  .disc-zero { fill: none; stroke: var(--on-signal); stroke-width: 3.6; stroke-linecap: butt; transform-box: view-box; transform-origin: 16px 16px; }
  .disc-zero path { stroke-width: 3.2; }
  /* The letters live in a column that closes to nothing, so the nav slides along as the name folds. */
  .word { display: grid; grid-template-columns: 1fr; transition: grid-template-columns 440ms cubic-bezier(0.45, 0, 0.55, 1) 60ms; }
  .word-clip { min-width: 0; overflow: hidden; }
  .word-in { display: inline-flex; align-items: baseline; padding: 4px 2px 0 11px; white-space: nowrap; font: 600 1.25rem/1 var(--display); letter-spacing: 0.005em; }
  .ch { display: inline-block; transition: opacity 150ms cubic-bezier(0.33, 0, 0.67, 1), transform 260ms cubic-bezier(0.2, 0.7, 0.2, 1); transition-delay: calc(140ms + var(--i) * 42ms); }
  .ch.big { font-weight: 900; letter-spacing: 0.02em; }
  .ch.gap { width: 0.3em; }
  .disc-zero { transition: transform 620ms cubic-bezier(0.45, 0, 0.55, 1); }
  /* Folded: the letters leave from the end back towards the disc, which spins a full turn backwards. */
  header.site[data-short] .word { grid-template-columns: 0fr; transition-delay: 90ms; }
  header.site[data-short] .ch { opacity: 0; transform: translateX(-0.5em); transition-delay: calc(var(--r) * 30ms); }
  header.site[data-short] .disc-zero { transform: rotate(-360deg); }
  header.site.still :is(.word, .ch, .disc-zero) { transition: none; }

  nav { display: flex; gap: 2px; flex-wrap: wrap; }
  nav a { position: relative; font: 700 0.96875rem/1 var(--body); color: var(--band-muted); text-decoration: none; padding: 12px 10px 9px; transition: color 150ms var(--ease); }
  nav a:hover { color: var(--on-band); }
  nav a[aria-current="page"] { color: var(--on-band); }
  /* The current page: a traffic-yellow bar along the band's bottom edge, like a platform's edge line. */
  nav a[aria-current="page"]::after { content: ""; position: absolute; left: 10px; right: 10px; bottom: -9px; height: 4px; background: var(--signal); }
  nav a:focus-visible, .actions :focus-visible { outline-color: var(--signal); }
  @media (forced-colors: active) { nav a[aria-current="page"]::after { background: Highlight; } }
  .actions { margin-left: auto; display: flex; gap: 8px; align-items: center; }
  .search-btn, .theme-toggle, .gh {
    display: inline-flex; align-items: center; gap: 8px; height: 38px; padding: 2px 12px 0; border-radius: var(--r); cursor: pointer;
    font: 600 0.9375rem/1 var(--body); color: var(--band-muted); background: transparent; border: 1px solid var(--band-rule); text-decoration: none;
    transition: border-color 150ms var(--ease), color 150ms var(--ease);
  }
  .search-btn:hover, .theme-toggle:hover, .gh:hover { border-color: var(--on-band); color: var(--on-band); }
  .search-btn { min-width: 172px; }
  .search-btn svg { width: 15px; height: 15px; margin-top: -2px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: square; }
  .search-btn kbd { margin-left: auto; font: 600 0.75rem/1 var(--data); padding: 4px 6px 3px; border-radius: 2px; border: 1px solid var(--band-rule); color: var(--band-muted); }
  .theme-toggle { width: 40px; padding: 0; justify-content: center; color: var(--on-band); }
  .theme-toggle svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .theme-toggle .i-moon { fill: currentColor; stroke: none; }
  .gh { color: var(--on-band); font-weight: 700; }
  .gh svg { width: 15px; height: 15px; margin-top: -2px; fill: currentColor; }
  .start {
    display: inline-flex; align-items: center; gap: 7px; height: 38px; padding: 3px 14px 0; border-radius: var(--r);
    font: 800 0.9375rem/1 var(--body); text-decoration: none; color: var(--on-signal); background: var(--signal); border: 2px solid var(--signal);
  }
  .start:hover { background: var(--band); color: var(--signal); }
  @media (max-width: 1060px) { .search-btn { min-width: 0; } .search-btn kbd { display: none; } }
  @media (max-width: 760px) {
    .bar { gap: 0 8px; padding-block: 6px 0; }
    nav { order: 3; width: 100%; margin-inline: -10px; }
    nav a { padding: 12px 10px 13px; }
    nav a[aria-current="page"]::after { bottom: 0; }
    .gh { display: none; }
    /* Hidden from sight but not from screen readers: it is the search button's name. */
    .search-word { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .search-btn { width: 40px; padding: 0; justify-content: center; }
  }

  .page { padding-block: 56px 104px; display: grid; grid-template-columns: minmax(0, 1fr); gap: 80px; }

  /* The footer is the same band as the header, under a strip of the ten lines end to end. */
  .site-foot { background: var(--band); color: var(--on-band); }
  .route { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(10, minmax(0, 1fr)); }
  .route li { position: relative; height: 10px; background: var(--c); }
  .route span { position: absolute; left: 50%; top: 50%; translate: -50% -50%; display: grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: #ffffff; box-shadow: inset 0 0 0 4px var(--c); color: #1e1e1e; font: 900 0.625rem/1 var(--display); padding-top: 2px; }
  @media (max-width: 560px) { .route span { width: 20px; height: 20px; font-size: 0; box-shadow: inset 0 0 0 3px var(--c); } }
  .foot { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 32px 48px; padding-block: 64px 28px; }
  .foot-brand { display: grid; gap: 14px; align-content: start; }
  .foot-mark { display: inline-flex; align-items: center; gap: 12px; font: 900 1.6rem/1 var(--display); letter-spacing: -0.01em; }
  .foot-mark span { padding-top: 4px; }
  .foot-mark .disc { width: 40px; height: 40px; }
  .foot-note { color: var(--band-muted); max-width: 44ch; }
  .foot-cols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .foot-cols div { display: grid; gap: 10px; align-content: start; }
