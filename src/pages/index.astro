---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import TrackCover from "../components/TrackCover.astro";
import { lookOf, stageNotes } from "../lib/track-look";
import { timeWeighted, volumeWeighted, type Sample } from "../lib/twap";
import settlements from "../../public/data/hip4-settlements.json";
import entries from "../data/changelog.json";
import meta from "../data/changelog-meta.json";

const tracks = (await getCollection("tracks")).sort((a, b) => a.data.order - b.data.order);
const stages = [...new Set(tracks.map((t) => t.data.stage))];
const docCount = new Set(tracks.flatMap((t) => t.data.docs.map((d) => d.url))).size;
const outsideCount = new Set(tracks.flatMap((t) => t.data.outside.map((d) => d.url))).size;
const kindLabel = { lab: "Lab", workbench: "Workbench", project: "Project", guide: "Guide" } as const;
const lessonCount = tracks.filter((t) => t.data.depth === "lesson").length;

// Hero specimen: a real Skew market where the two averages disagree, drawn from the lab's dataset.
type Market = { outcome: number; group: string; venue: string; coin: string; threshold: string; actualYes: boolean; windowStartMs: number; windowEndMs: number; samples: Sample[] };
const markets = settlements.markets as unknown as Market[];
const hero = markets.find((m) => m.group === "Averages disagree" && m.venue === "skew") ?? markets[0];
const L = hero.windowEndMs - hero.windowStartMs;
const th = Number(hero.threshold);
const twap = timeWeighted(hero.samples, L)!;
const vwap = volumeWeighted(hero.samples, L)!;
const pts = hero.samples.filter((s) => s[0] >= -15_000 && s[0] <= L);
const t0 = Math.min(...pts.map((s) => s[0]));
const prices = [...pts.map((s) => s[1]), th];
const lo = Math.min(...prices), hi = Math.max(...prices);
const W = 300, H = 120, pad = 8;
const x = (t: number) => pad + ((t - t0) / (L - t0)) * (W - 2 * pad);
const y = (p: number) => H - pad - ((p - lo) / (hi - lo || 1)) * (H - 2 * pad);
const trace = pts.map((s, i) => `${i ? "L" : "M"}${x(s[0]).toFixed(1)} ${y(s[1]).toFixed(1)}`).join(" ");
const fmt = (n: number) => n.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const says = (v: number) => (v > th ? "Yes" : "No");

// The latest changelog entries, newest first.
type Entry = { time: string; network: string; area: string; summary: string };
const latest = (entries as Entry[]).slice(0, 5);
const day = (iso: string) => new Date(iso).toLocaleDateString("en-GB", { day: "numeric", month: "short", timeZone: "UTC" });
const escape = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
const inline = (s: string) => escape(s).replace(/`([^`]+)`/g, "<code>$1</code>").replace(/\[([^\]]+)\]\((https:\/\/[^)\s]+)\)/g, "$1");
const c = meta.counts;

const labs = [
  { n: "01", code: "T3", href: "/labs/sign-without-money/", title: "Sign without money", note: "Testnet · throwaway key", what: "Sign a cancel with a key made in your browser. The exchange's error names the address it recovered, so you know whether your encoding is right." },
  { n: "02", code: "T4", href: "/labs/funding/", title: "Funding and mark price", note: "Mainnet · read-only", what: "Live oracle, mark and impact prices for any perp, with the premium and the hour's funding worked out next to the API's own number." },
  { n: "03", code: "T8", href: "/labs/settlement/", title: "Settlement explorer", note: `${markets.length} real settlements`, what: "Replay HIP-4 settlements from the prices hyperkeeper recorded, and see which average each venue really uses." },
];
---

<Base title="Zero to HYPE" description="A free, open-source roadmap for building on Hyperliquid: every topic mapped to the official docs and the best tutorials, with labs that run in your browser.">
  <section class="hero">
    <div class="hero-copy">
      <a class="pill hero-pill" href="/changelog/"><span class="live-dot"></span>API checked every 6 hours · <b>{c.mainnet.perps} perps, {c.mainnet.dexs} HIP-3 DEXs</b></a>
      <h1>From your first API call to your own <em>perp&nbsp;DEX.</em></h1>
      <p class="lede">
        A free, open-source roadmap for building on Hyperliquid. Ten tracks, each mapped to the
        official docs and the best outside guides, with labs that run against the real API in your
        browser.
      </p>
      <div class="ctas">
        <a class="btn" href="/tracks/t01-orientation/">Start with T1 <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn ghost" href="/labs/">Try a lab</a>
      </div>
      <ul class="facts" aria-label="What the roadmap covers">
        <li><b>{tracks.length}</b> tracks</li>
        <li><b>{lessonCount}</b> full lessons</li>
        <li><b>{docCount}</b> official pages mapped</li>
        <li><b>{outsideCount}</b> outside guides</li>
        <li><b>0</b> sign-ups</li>
      </ul>
    </div>

    <div class="specimens" aria-label="Examples from the labs">
      <a class="spec spec-settle" href="/labs/settlement/" style={`--c: ${lookOf("T8").color}`}>
        <span class="spec-head"><span class="eyebrow">Settlement · {hero.venue} · {hero.coin}</span><span class="tag">outcome {hero.outcome}</span></span>
        <svg viewBox={`0 0 ${W} ${H}`} class="spark" aria-hidden="true" data-kind="price" data-pad={pad} data-h={H} data-lo={lo} data-hi={hi} data-t0={t0} data-len={L}>
          <rect x={x(0)} y="0" width={x(L) - x(0)} height={H} class="win" />
          <path d={`M${pad} ${y(th)} H${W - pad}`} class="thr" />
          <path d={trace} class="trace" data-snap="trace" data-flow="1" />
        </svg>
        <span class="spec-rows">
          <span><span>Volume-weighted</span><b>{fmt(vwap)}</b><span class={says(vwap) === "Yes" === hero.actualYes ? "ok" : "no"}>{says(vwap)} {says(vwap) === "Yes" === hero.actualYes ? "✓" : "✗"}</span></span>
          <span><span>Time-weighted</span><b>{fmt(twap)}</b><span class={says(twap) === "Yes" === hero.actualYes ? "ok" : "no"}>{says(twap)} {says(twap) === "Yes" === hero.actualYes ? "✓" : "✗"}</span></span>
        </span>
        <span class="spec-foot">Threshold {fmt(th)} · venue settled {hero.actualYes ? "Yes" : "No"}</span>
      </a>

      <a class="spec spec-sign" href="/labs/sign-without-money/" style={`--c: ${lookOf("T3").color}`}>
        <span class="eyebrow">POST /exchange · testnet</span>
        <ol class="recipe">
          <li><code>msgpack(action)</code></li>
          <li>+ nonce, vault → <code>keccak256</code></li>
          <li>sign a small EIP-712 message</li>
        </ol>
        <span class="reply">“User or API Wallet <b>0x…</b> does not exist.”</span>
        <span class="spec-foot">Your key's address? Your encoding is right.</span>
      </a>

      {latest[0] && (
        <a class="spec spec-log" href="/changelog/">
          <span class="eyebrow"><span class="live-dot"></span> Changelog · {day(latest[0].time)}</span>
          <span class="log-line"><span class="net">{latest[0].network}</span> <span set:html={inline(latest[0].summary)} /></span>
        </a>
      )}
    </div>
  </section>

  <section class="roadmap" aria-labelledby="roadmap-title">
    <div class="section-head">
      <p class="eyebrow">The roadmap</p>
      <h2 id="roadmap-title">Ten tracks, in the order you'll need them.</h2>
      <p class="muted">Every track lists the official pages to read first, the outside guides worth your time, and what to build. Lessons add the parts the docs leave out.</p>
    </div>

    {stages.map((stage, si) => (
      <div class="stage">
        <div class="stage-head">
          <span class="stage-num">{String(si + 1).padStart(2, "0")}</span>
          <div>
            <h3>{stage}</h3>
            <p class="muted">{stageNotes[stage]}</p>
          </div>
        </div>
        <ol class="cards">
          {tracks
            .filter((t) => t.data.stage === stage)
            .map((t) => (
              <li>
                <a class="card" href={`/tracks/${t.id}/`} style={`--c: ${lookOf(t.data.code).color}`}>
                  <TrackCover code={t.data.code} />
                  <span class="card-body">
                    <span class="card-kicker">
                      <span class="eyebrow">{t.data.code}</span>
                      {t.data.depth === "lesson" ? <span class="tag ok">Lesson</span> : <span class="tag">Reading list</span>}
                    </span>
                    <span class="card-title">{t.data.title}</span>
                    <span class="card-summary">{t.data.summary}</span>
                    {t.data.build.length > 0 && (
                      <span class="card-build">
                        {t.data.build.slice(0, 3).map((b) => (
                          <span class={b.status === "live" ? "live-item" : undefined}>+ {kindLabel[b.kind]}: {b.label}{b.status === "live" && <em> · live</em>}</span>
                        ))}
                      </span>
                    )}
                    <span class="card-foot">
                      <span class="meta">{t.data.docs.length} official · {t.data.outside.length} outside</span>
                      <span class="open">Open <span aria-hidden="true">→</span></span>
                    </span>
                  </span>
                </a>
              </li>
            ))}
        </ol>
      </div>
    ))}
  </section>

  <section class="labs" aria-labelledby="labs-title">
    <div class="section-head">
      <p class="eyebrow">Labs</p>
      <h2 id="labs-title">Things you can run, not just read.</h2>
      <p class="muted">Each lab talks to Hyperliquid's API straight from your browser. None needs funds or a real key, and none can change anything on the exchange.</p>
    </div>
    <ol class="tiles">
      {labs.map((lab) => (
        <li>
          <a class="tile" href={lab.href} style={`--c: ${lookOf(lab.code).color}`}>
            <span class="tile-top">
              <span class="eyebrow">{lab.note}</span>
              <span class="tile-n">{lab.n}</span>
            </span>
            <span class="tile-title">{lab.title}</span>
            <span class="tile-what">{lab.what}</span>
            <span class="tile-go" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="stay" aria-labelledby="stay-title">
    <div class="stay-copy">
      <p class="eyebrow">API changelog</p>
      <h2 id="stay-title">The API changes before the docs do.</h2>
      <p class="muted">
        Hyperliquid publishes no changelog. A job checks mainnet, testnet and every docs page every
        6 hours and records what changed: new perps and HIP-3 DEXs, permission grants, HIP-4 venues
        and edited pages.
      </p>
      <a class="btn ghost" href="/changelog/">Read the changelog <span class="arrow" aria-hidden="true">→</span></a>
    </div>
    <div class="feed">
      <div class="feed-counts">
        <span><b>{c.mainnet.perps}</b>perps</span>
        <span><b>{c.mainnet.dexs}</b>HIP-3 DEXs</span>
        <span><b>{c.mainnet.venues}</b>HIP-4 venues</span>
        <span><b>{c.docs.pages}</b>docs pages</span>
      </div>
      <ul class="feed-list">
        {latest.map((e) => (
          <li>
            <span class="feed-meta"><span>{day(e.time)}</span><span class={`net ${e.network}`}>{e.network}</span><span>{e.area}</span></span>
            <span class="feed-text" set:html={inline(e.summary)} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="why" aria-labelledby="why-title">
    <h2 id="why-title" class="why-title">A map, not a course. <span class="muted">It sends you to the best page on each topic, then fills in what that page leaves out.</span></h2>
    <ol class="why-list">
      <li><span class="why-n">01</span><p><b>Free, with no sign-up.</b> No account, no email, no paywall.</p></li>
      <li><span class="why-n">02</span><p><b>Checked against the live API.</b> Every lesson shows the day its facts were last checked.</p></li>
      <li><span class="why-n">03</span><p><b>Labs that can't cost you money.</b> They use testnet, read-only calls or recorded data, and keys made in your browser.</p></li>
      <li><span class="why-n">04</span><p><b>Open source.</b> Code under MIT, writing under CC BY 4.0. Spot a mistake? <a href="https://github.com/vignesh-chaturvedi/zerotohype/issues">Open an issue</a>.</p></li>
    </ol>
  </section>
</Base>

<style>
  /* Hero */
  .hero { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 48px; align-items: center; padding-block: 16px 24px; }
  .hero-copy { display: grid; gap: 22px; justify-items: start; }
  .hero-pill { text-decoration: none; }
  .hero-pill:hover { border-color: var(--rule-strong); color: var(--ink); }
  .hero h1 { font-size: clamp(2.6rem, 6.4vw, 4.6rem); line-height: 1; letter-spacing: -0.05em; font-weight: 500; }
  .hero h1 em { font-style: normal; font-family: var(--data); font-weight: 400; letter-spacing: -0.09em; color: var(--accent); white-space: nowrap; }
  .ctas { display: flex; flex-wrap: wrap; gap: 10px; }
  .facts { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 6px 18px; font: 400 12px/1.5 var(--data); color: var(--muted); }
  .facts b { color: var(--ink); font-weight: 500; }

  .specimens { position: relative; display: grid; gap: 14px; }
  .spec {
    display: grid; gap: 10px; padding: 16px 18px; border-radius: 16px; text-decoration: none; color: var(--ink);
    background: var(--surface); border: 1px solid var(--rule); box-shadow: var(--shadow);
    transition: transform 220ms var(--ease), box-shadow 220ms var(--ease);
  }
  .spec:hover { box-shadow: var(--shadow-lift); }
  .spec-settle { border-top: 6px solid var(--c); transform: rotate(-1.2deg); }
  .spec-settle:hover { transform: rotate(-1.2deg) translateY(-3px); }
  .spec-sign { width: 86%; justify-self: end; background: color-mix(in srgb, var(--c) calc(var(--cover-amt) * 0.55), var(--surface)); border-color: color-mix(in srgb, var(--c) 60%, var(--rule)); transform: rotate(1.4deg); }
  .spec-sign:hover { transform: rotate(1.4deg) translateY(-3px); }
  .spec-log { width: 78%; transform: rotate(-0.6deg); }
  .spec-log:hover { transform: rotate(-0.6deg) translateY(-3px); }
  .spec-head { display: flex; justify-content: space-between; gap: 10px; align-items: center; flex-wrap: wrap; }
  .spark { width: 100%; height: auto; display: block; color: var(--ink); overflow: visible; }
  .spark .win { fill: color-mix(in srgb, var(--c) 45%, transparent); }
  .spark .thr { stroke: var(--accent); stroke-width: 1.4; stroke-dasharray: 4 4; fill: none; }
  .spark .trace { stroke: var(--ink); stroke-width: 1.4; fill: none; stroke-linejoin: round; }
  .spec-rows { display: grid; gap: 4px; font: 400 12px/1.5 var(--data); }
  .spec-rows > span { display: grid; grid-template-columns: minmax(0, 1fr) auto 3.4rem; gap: 10px; align-items: baseline; }
  .spec-rows b { font-weight: 500; font-variant-numeric: tabular-nums; }
  .spec-rows .ok { color: var(--ok); text-align: right; }
  .spec-rows .no { color: var(--mvp); text-align: right; }
  .spec-foot { font-size: 12.5px; color: var(--muted); }
  .recipe { margin: 0; padding-left: 1.2em; display: grid; gap: 4px; font: 400 12px/1.5 var(--data); }
  .recipe code { background: color-mix(in srgb, var(--surface) 70%, transparent); }
  .reply { font: 400 12px/1.5 var(--data); color: var(--ink-2); }
  .reply b { color: var(--accent); font-weight: 500; }
  .spec-log .eyebrow { display: inline-flex; align-items: center; gap: 8px; }
  .log-line { font-size: 14px; line-height: 1.5; }
  .log-line .net { font: 500 10px/1 var(--data); letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); }

  /* Section heads */
  .section-head { display: grid; gap: 12px; max-width: 66ch; }
  .section-head h2 { font-size: clamp(1.9rem, 4.4vw, 3rem); letter-spacing: -0.045em; line-height: 1.02; }

  /* Roadmap */
  .roadmap { display: grid; gap: 40px; padding-top: 24px; border-top: 1px solid var(--rule); }
  .stage { display: grid; gap: 18px; }
  .stage-head { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 16px; align-items: baseline; }
  .stage-num { font: 400 13px/1 var(--data); color: var(--muted); padding: 6px 8px; border: 1px solid var(--rule-strong); border-radius: 8px; }
  .stage-head h3 { font-size: 1.35rem; font-weight: 600; letter-spacing: -0.02em; }
  .stage-head p { font-size: 15px; }
  .cards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .card {
    height: 100%; display: grid; grid-template-rows: auto 1fr; gap: 0; padding: 10px; border-radius: 22px; text-decoration: none; color: var(--ink);
    background: color-mix(in srgb, var(--c) calc(var(--cover-amt) * 0.42), var(--surface));
    border: 1px solid color-mix(in srgb, var(--c) 55%, var(--rule));
    transition: transform 220ms var(--ease), box-shadow 220ms var(--ease);
  }
  .card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lift); }
  .card-body { display: grid; gap: 10px; align-content: start; padding: 16px 10px 8px; }
  .card-kicker { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .card-title { font: 600 1.4rem/1.1 var(--display); letter-spacing: -0.025em; }
  .card-summary { font-size: 14.5px; line-height: 1.55; color: var(--ink-2); }
  .card-build { display: grid; gap: 3px; font-size: 13.5px; color: var(--ink-2); }
  .card-build .live-item { color: var(--ink); font-weight: 600; }
  .card-build em { font-style: normal; font: 500 10px/1 var(--data); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ok); }
  .card-foot { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-top: 6px; padding-top: 12px; border-top: 1px solid color-mix(in srgb, var(--c) 60%, var(--rule)); }
  .meta { font: 400 11px/1.4 var(--data); color: var(--muted); }
  .open { font-weight: 600; font-size: 14px; }
  .card:hover .open span { display: inline-block; transform: translateX(3px); transition: transform 180ms var(--ease); }

  /* Labs */
  .labs { display: grid; gap: 24px; padding-top: 24px; border-top: 1px solid var(--rule); }
  .tiles { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .tile {
    position: relative; min-height: 300px; height: 100%; display: grid; grid-template-rows: auto 1fr auto auto; gap: 12px; padding: 22px; border-radius: 22px;
    text-decoration: none; color: var(--cover-ink); background: color-mix(in srgb, var(--c) var(--cover-amt), var(--surface));
    transition: transform 220ms var(--ease), box-shadow 220ms var(--ease);
  }
  .tile:hover { transform: translateY(-4px); box-shadow: var(--shadow-lift); }
  .tile .eyebrow { color: inherit; opacity: 0.75; }
  .tile-top { display: flex; justify-content: space-between; align-items: start; gap: 12px; }
  .tile-n { font: 400 clamp(2.6rem, 5vw, 3.6rem)/0.8 var(--data); letter-spacing: -0.08em; }
  .tile-title { font: 600 1.6rem/1.05 var(--display); letter-spacing: -0.035em; align-self: end; }
  .tile-what { font-size: 14.5px; line-height: 1.55; opacity: 0.85; padding-right: 44px; }
  .tile-go { position: absolute; right: 18px; bottom: 18px; width: 38px; height: 38px; display: grid; place-items: center; border-radius: 50%; background: color-mix(in srgb, var(--cover-ink) 12%, transparent); font-size: 17px; transition: transform 180ms var(--ease); }
  .tile:hover .tile-go { transform: translateX(3px); }

  /* Changelog preview */
  .stay { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 40px; align-items: start; padding-top: 24px; border-top: 1px solid var(--rule); }
  .stay-copy { display: grid; gap: 14px; justify-items: start; }
  .stay-copy h2 { font-size: clamp(1.9rem, 4vw, 2.7rem); letter-spacing: -0.045em; line-height: 1.02; }
  .feed { border: 1px solid var(--rule); border-radius: 18px; background: var(--surface); box-shadow: var(--shadow); overflow: hidden; }
  .feed-counts { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-bottom: 1px solid var(--rule); background: var(--sunk); }
  .feed-counts span { display: grid; gap: 2px; padding: 14px 16px; font-size: 12.5px; color: var(--muted); }
  .feed-counts span + span { border-left: 1px solid var(--rule); }
  .feed-counts b { font: 500 1.35rem/1.1 var(--data); color: var(--ink); letter-spacing: -0.04em; }
  .feed-list { list-style: none; margin: 0; padding: 0; }
  .feed-list li { display: grid; gap: 4px; padding: 13px 16px; border-bottom: 1px solid var(--rule); }
  .feed-list li:last-child { border-bottom: 0; }
  .feed-meta { display: flex; gap: 12px; font: 500 10px/1.4 var(--data); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .feed-meta .mainnet { color: var(--accent); }
  .feed-text { font-size: 14.5px; overflow-wrap: anywhere; }

  /* Principles */
  .why { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 40px; padding-top: 24px; border-top: 1px solid var(--rule); }
  .why-title { font-size: clamp(1.7rem, 3.6vw, 2.5rem); letter-spacing: -0.04em; line-height: 1.12; }
  .why-title .muted { font-weight: 400; }
  .why-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
  .why-list li { display: grid; grid-template-columns: 3rem minmax(0, 1fr); padding: 16px 0; border-bottom: 1px solid var(--rule); color: var(--ink-2); }
  .why-list li:first-child { padding-top: 4px; }
  .why-list b { color: var(--ink); font-weight: 600; margin-right: 4px; }
  .why-n { font: 400 12px/1.9 var(--data); color: var(--muted); }

  @media (max-width: 1000px) {
    .cards, .tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 860px) {
    .hero, .stay, .why { grid-template-columns: minmax(0, 1fr); }
    .specimens { max-width: 520px; }
  }
  @media (max-width: 620px) {
    .cards, .tiles { grid-template-columns: minmax(0, 1fr); }
    .spec-sign, .spec-log { width: 100%; }
    .spec-log { display: none; }
    .feed-counts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .feed-counts span:nth-child(3) { border-left: 0; }
