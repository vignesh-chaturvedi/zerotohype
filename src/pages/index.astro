---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import TrackCover from "../components/TrackCover.astro";
import Station from "../components/Station.astro";
import { lineStyle, lookOf, stageNotes } from "../lib/track-look";
import { timeWeighted, volumeWeighted, type Sample } from "../lib/twap";
import settlements from "../../public/data/hip4-settlements.json";
import entries from "../data/changelog.json";
import meta from "../data/changelog-meta.json";

const tracks = (await getCollection("tracks")).sort((a, b) => a.data.order - b.data.order);
const stages = [...new Set(tracks.map((t) => t.data.stage))];
const docCount = new Set(tracks.flatMap((t) => t.data.docs.map((d) => d.url))).size;
const outsideCount = new Set(tracks.flatMap((t) => t.data.outside.map((d) => d.url))).size;
const kindLabel = { lab: "Lab", workbench: "Workbench", project: "Project", guide: "Guide" } as const;
const lessonCount = tracks.filter((t) => t.data.depth === "lesson").length;
const count = (n: number, one: string, many = `${one}s`) => `${n} ${n === 1 ? one : many}`;

// Hero specimen: a real Skew market where the two averages disagree, drawn from the lab's dataset.
type Market = { outcome: number; group: string; venue: string; coin: string; threshold: string; actualYes: boolean; windowStartMs: number; windowEndMs: number; samples: Sample[] };
const markets = settlements.markets as unknown as Market[];
const hero = markets.find((m) => m.group === "Averages disagree" && m.venue === "skew") ?? markets[0];
const L = hero.windowEndMs - hero.windowStartMs;
const th = Number(hero.threshold);
const twap = timeWeighted(hero.samples, L)!;
const vwap = volumeWeighted(hero.samples, L)!;
const pts = hero.samples.filter((s) => s[0] >= -15_000 && s[0] <= L);
const t0 = Math.min(...pts.map((s) => s[0]));
const prices = [...pts.map((s) => s[1]), th];
const lo = Math.min(...prices), hi = Math.max(...prices);
const W = 300, H = 120, pad = 8;
const x = (t: number) => pad + ((t - t0) / (L - t0)) * (W - 2 * pad);
const y = (p: number) => H - pad - ((p - lo) / (hi - lo || 1)) * (H - 2 * pad);
const trace = pts.map((s, i) => `${i ? "L" : "M"}${x(s[0]).toFixed(1)} ${y(s[1]).toFixed(1)}`).join(" ");
const fmt = (n: number) => n.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const says = (v: number) => (v > th ? "Yes" : "No");

// The latest changelog entries, newest first.
type Entry = { time: string; network: string; area: string; summary: string };
const latest = (entries as Entry[]).slice(0, 5);
const day = (iso: string) => new Date(iso).toLocaleDateString("en-GB", { day: "numeric", month: "short", timeZone: "UTC" });
const escape = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
const inline = (s: string) => escape(s).replace(/`([^`]+)`/g, "<code>$1</code>").replace(/\[([^\]]+)\]\((https:\/\/[^)\s]+)\)/g, "$1");
const c = meta.counts;

// The departure board's rows: the busiest perps, plus HYPE.
const boardCoins = ["BTC", "ETH", "HYPE", "SOL", "XRP", "DOGE", "SUI", "ENA"];
// Each tile shows what its lab works with: the signing recipe, the settlement chart, or a few lines of it.
const labs: { n: string; code: string; href: string; title: string; note: string; what: string; lines?: string[] }[] = [
  { n: "01", code: "T3", href: "/labs/sign-without-money/", title: "Sign without money", note: "Testnet · throwaway key", what: "Sign a cancel with a key made in your browser. The exchange's error names the address it recovered, so you know whether your encoding is right." },
  { n: "02", code: "T4", href: "/labs/funding/", title: "Funding and mark price", note: "Mainnet · read-only", what: "Live oracle, mark and impact prices for any perp, with the premium and the hour's funding worked out next to the API's own number.", lines: ["premium = (impact − oracle) / oracle", "funding / h = clamp(premium + interest) / 8"] },
  { n: "03", code: "T8", href: "/labs/settlement/", title: "Settlement explorer", note: `${markets.length} real settlements`, what: "Replay real HIP-4 settlements from prices recorded by hyperkeeper, an open-source tool for market deployers, and see which average each venue really uses." },
  { n: "04", code: "T2", href: "/labs/order-book/", title: "Live order book", note: "Mainnet · live feed", what: "Any perp or spot pair's book from the WebSocket, with the settings that group it, the messages themselves and what a market order would cost.", lines: ['{ "type": "l2Book", "coin": "BTC" }', "nSigFigs 2–5 · mantissa 2 or 5", "fast: 5 levels, twice a second"] },
  { n: "05", code: "T2", href: "/labs/tick-and-lot/", title: "Tick and lot sizes", note: "Mainnet · read-only", what: "Type a price and a size and see whether the exchange would take them, the nearest values it would, and tested code that rounds them.", lines: ['73836.408 → "73836"', "at most 5 significant figures", "at most 6 − szDecimals decimals"] },
  { n: "06", code: "T4", href: "/labs/liquidation-price/", title: "Margin and liquidation price", note: "Mainnet · read-only", what: "Work out a position's liquidation price, margin tiers included, and check the formula against the API's own number for real positions.", lines: ["liq = price − side × margin", "      / size / (1 − rate × side)", "rate = 1 / (2 × max leverage)"] },
];

// Shorter routes through the roadmap, by what the reader is building.
const byCode = new Map(tracks.map((t) => [t.data.code, { id: t.id, code: t.data.code, title: t.data.title }]));
const paths = [
  { name: "A trading bot", codes: ["T1", "T2", "T3", "T4"], what: "Read the exchange, sign orders, and know how positions are priced, margined and funded." },
  { name: "An app that earns from its order flow", codes: ["T1", "T3", "T5"], what: "Place orders for your users and take a builder fee on each fill." },
  { name: "Your own market", codes: ["T1", "T3", "T6", "T7", "T8"], what: "Launch a token, run a HIP-3 perp DEX or settle HIP-4 outcome markets." },
  { name: "Contracts on HyperEVM", codes: ["T1", "T9"], what: "Read HyperCore from Solidity and act on it through CoreWriter." },
].map((p) => ({ ...p, steps: p.codes.map((c) => byCode.get(c)!) }));
const plannedCount = (t: (typeof tracks)[number]) => t.data.build.filter((b) => b.status !== "live").length;
---

<Base title="Zero to HYPE: learn to build on Hyperliquid" heading="From your first API call to your own perp DEX." description="A free, open-source roadmap for building on Hyperliquid: every topic mapped to the official docs and the best tutorials, with labs that run in your browser.">
  <Fragment slot="stage">
    <section class="stage" aria-labelledby="hero-title">
      <div class="wrap stage-grid">
        <div class="stage-copy">
          <p class="eyebrow plate">Free · open source · no sign-up</p>
          <h1 id="hero-title">From your first API call to your own <em>perp&nbsp;DEX</em>.</h1>
          <p class="lede">
            A roadmap for building on Hyperliquid. Ten tracks, each mapped to the official docs and the
            best outside guides, with labs that run against the real API in your browser.
          </p>
          <div class="ctas">
            <a class="btn" href="/tracks/t01-orientation/">Start with T1 <span class="arrow" aria-hidden="true">→</span></a>
            <a class="btn ghost" href="/labs/">Try a lab</a>
          </div>
        </div>

        {/* A departure board for the market: live mids on split flaps (board.ts). */}
        <section class="board" data-board aria-labelledby="board-title">
          <header class="board-head">
            <h2 id="board-title">Perps <span>Hyperliquid mainnet</span></h2>
            <p class="board-next">Next funding <b data-funding>--:--</b></p>
          </header>
          <table class="board-table">
            <thead>
              <tr><th scope="col">Market</th><th scope="col">Mid</th><th scope="col">24h</th></tr>
            </thead>
            <tbody>
              {boardCoins.map((coin) => (
                <tr data-mid={coin}>
                  <th scope="row">
                    <span class="flaps" aria-hidden="true">{[...coin.padEnd(4, " ")].map((ch) => <span class="flap" data-ch={ch}><span class="u">{ch}</span><span class="d">{ch}</span></span>)}</span>
                    <span class="visually-hidden">{coin}</span>
                  </th>
                  <td>
                    <span class="flaps" data-px aria-hidden="true">{Array.from({ length: 8 }, () => <span class="flap" data-ch=" "><span class="u"> </span><span class="d"> </span></span>)}</span>
                    <span class="visually-hidden" data-px-text>Loading</span>
                  </td>
                  <td class="chg" data-chg>…</td>
                </tr>
              ))}
            </tbody>
          </table>
          <footer class="board-foot">
            <span class="cap" data-board-caption data-state="waiting">Connecting to api.hyperliquid.xyz…</span>
            {/* Pauses the board's prices and clock and the drawings' moving dots (motion.ts); shown once the script runs. */}
            <button type="button" class="motion-btn" data-motion-toggle hidden>
              <svg viewBox="0 0 12 12" aria-hidden="true"><path class="i-pause" d="M3.8 2.6v6.8M8.2 2.6v6.8" /><path class="i-play" d="M3.4 2.2 10 6l-6.6 3.8Z" /></svg>
              <span data-motion-label>Pause motion</span>
            </button>
          </footer>
        </section>
      </div>
    </section>
  </Fragment>

  <section class="roadmap" aria-labelledby="roadmap-title">
    <div class="section-head">
      <p class="eyebrow plate"><b>01</b>The roadmap</p>
      <h2 id="roadmap-title">Ten tracks, in the order you'll need them.</h2>
      <p class="muted">
        {count(docCount, "official page")} and {count(outsideCount, "outside guide")}, sorted into tracks. Each one says what
        to read first, what's worth reading next and what to build. {lessonCount} of {tracks.length} have full lessons;
        the other {tracks.length - lessonCount} are reading lists for now. You need HTTP and a little Python or TypeScript;
        Solidity only comes in at T9.
      </p>
      <div class="progress" data-progress>
        <span class="progress-bar"><span></span></span>
        <span class="progress-text"><b data-progress-text>0 of {tracks.length} done</b> · Tick a track off on its page. It's saved in this browser only.</span>
      </div>
    </div>

    <div class="paths">
      <h3 id="paths-title" class="eyebrow">Shorter routes, by what you're building</h3>
      <ul>
        {paths.map((p) => (
          <li class="path">
            <p class="path-name">{p.name}</p>
            <p class="path-what">{p.what}</p>
            <ol class="path-codes">
              {p.steps.map((s) => (
                <li><a href={`/tracks/${s.id}/`} aria-label={`${s.code} ${s.title}`} title={`${s.code} ${s.title}`}><Station code={s.code} size="s" /></a></li>
              ))}
            </ol>
          </li>
        ))}
      </ul>
    </div>

    <div class="index">
      <div class="groups">
        {stages.map((stage, si) => (
          <div class="group">
            <p class="group-head"><span class="group-n">Stage {si + 1}</span><span class="group-name">{stage}</span><span class="group-note">{stageNotes[stage]}</span></p>
            <ol class="rows">
              {tracks.filter((t) => t.data.stage === stage).map((t) => (
                <li>
                  <a class="row" href={`/tracks/${t.id}/`} data-code={t.data.code} data-done-id={t.id} style={lineStyle(t.data.code)}>
                    <span class="row-stn"><Station code={t.data.code} /></span>
                    <span class="row-main">
                      <span class="row-title">{t.data.title}</span>
                      <span class="row-sum">{t.data.summary}</span>
                    </span>
                    <span class="row-side">
                      <span class={`row-depth ${t.data.depth}`}>{t.data.depth === "lesson" ? "Lesson" : "Reading list"}</span>
                      <span class="row-done" aria-hidden="true"><svg viewBox="0 0 12 12"><path d="M2.6 6.3 5 8.6 9.6 3.6" /></svg></span>
                      <span class="visually-hidden row-done-text">(done)</span>
                    </span>
                    <span class="row-thumb"><TrackCover code={t.data.code} variant="thumb" /></span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        ))}
      </div>

      <aside class="preview" aria-hidden="true" data-motion-manual>
        {tracks.map((t, i) => (
          <div class={`pv${i === 0 ? " on" : ""}`} data-code={t.data.code} style={`--c: ${lookOf(t.data.code).color}`}>
            <TrackCover code={t.data.code} label={t.data.stage} />
            <div class="pv-body">
              <p class="pv-title"><Station code={t.data.code} size="s" />{t.data.title}</p>
              <p class="pv-sum">{t.data.summary}</p>
              {t.data.build.length > 0 && (
                <ul class="pv-build">
                  {t.data.build.filter((b) => b.status === "live").map((b) => (
                    <li class="live">{kindLabel[b.kind]}: {b.label}<b> · live</b></li>
                  ))}
                  {plannedCount(t) > 0 && <li class="planned">{plannedCount(t)} more planned</li>}
                </ul>
              )}
              <p class="pv-meta">{count(t.data.docs.length, "official page")} · {count(t.data.outside.length, "outside guide")}</p>
            </div>
          </div>
        ))}
      </aside>
    </div>
  </section>

  <section class="labs" aria-labelledby="labs-title">
    <div class="section-head">
      <p class="eyebrow plate"><b>02</b>Labs</p>
      <h2 id="labs-title">Things you can run, not just read.</h2>
      <p class="muted">Each lab talks to Hyperliquid's API straight from your browser. None needs funds or a real key, and none can change anything on the exchange.</p>
    </div>
    <ol class="tiles">
      {labs.map((lab) => (
        <li>
          <a class="tile" href={lab.href} style={lineStyle(lab.code)}>
            <span class="tile-top">
              <span class="tile-n">Lab {lab.n}</span>
              <span class="tile-note">{lab.note}</span>
            </span>
            <span class="tile-body">
              {lab.n === "03" ? (
                <svg viewBox={`0 0 ${W} ${H}`} class="spark" aria-hidden="true" data-kind="price" data-pad={pad} data-h={H} data-lo={lo} data-hi={hi} data-t0={t0} data-len={L}>
                  <rect x={x(0)} y="0" width={x(L) - x(0)} height={H} class="win" />
                  <path d={`M${pad} ${y(th)} H${W - pad}`} class="thr" />
                  <path d={trace} class="trace" data-snap="trace" data-flow="1" />
                </svg>
              ) : lab.n === "01" ? (
                <ol class="recipe" aria-hidden="true">
                  <li><code>msgpack(action)</code></li>
                  <li>+ nonce, vault → <code>keccak256</code></li>
                  <li>sign a small EIP-712 message</li>
                  <li class="reply">“User or API Wallet <b>0x…</b> does not exist.”</li>
                </ol>
              ) : (
                <span class="formula" aria-hidden="true">{(lab.lines ?? []).map((line) => <span>{line}</span>)}</span>
              )}
              <span class="tile-title">{lab.title}</span>
              <span class="tile-what">{lab.what}</span>
              <span class="tile-go"><span class="tile-track"><Station code={lab.code} size="s" /></span>Open lab <span aria-hidden="true">→</span></span>
            </span>
          </a>
        </li>
      ))}
    </ol>
    <p class="finding">
      <b>A finding from the recordings.</b> Markets that say "TWAP" don't always settle on a time-weighted average. From 13 Oct
      to 6 Nov, a volume-weighted average of BTC trades matched all 1,121 of Skew's settlements; a time-weighted one missed five.
      Lab 03's chart is Skew outcome {hero.outcome}{says(twap) !== (hero.actualYes ? "Yes" : "No") ? ", one of those five" : ""}:
      the time-weighted average said {says(twap)}, the volume-weighted one said {says(vwap)}, and Skew settled {hero.actualYes ? "Yes" : "No"}.
    </p>
  </section>

  <section class="stay" aria-labelledby="stay-title">
    <div class="stay-copy">
      <p class="eyebrow plate"><b>03</b>API changelog</p>
      <h2 id="stay-title">The API changes before the docs do.</h2>
      <p class="muted">
        Hyperliquid publishes no changelog. A job checks mainnet, testnet and every docs page every
        6 hours and records what changed: new perps and HIP-3 DEXs, permission grants, HIP-4 venues
        and edited pages.
      </p>
      <a class="btn ghost" href="/changelog/">Read the changelog <span class="arrow" aria-hidden="true">→</span></a>
    </div>
    {/* Service changes, on a station's information screen. */}
    <div class="feed">
      <p class="feed-head">Service changes</p>
      <div class="feed-counts">
        <span><b>{c.mainnet.perps}</b> perps</span>
        <span><b>{c.mainnet.dexs}</b> HIP-3 DEXs</span>
        <span><b>{c.mainnet.venues}</b> HIP-4 venues</span>
        <span><b>{c.docs.pages}</b> docs pages</span>
      </div>
      <ul class="feed-list">
        {latest.map((e) => (
          <li>
            <span class="feed-meta"><span>{day(e.time)}</span><span class={`net ${e.network}`}>{e.network}</span><span>{e.area}</span></span>
            <span class="feed-text" set:html={inline(e.summary)} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="why" aria-labelledby="why-title">
    <h2 id="why-title" class="why-title">A map, not a course. <span class="muted">It sends you to the best page on each topic, then fills in what that page leaves out.</span></h2>
    <ol class="why-list">
      <li><span class="why-n">1</span><p><b>Free, with no sign-up.</b> No account, no email, no paywall.</p></li>
      <li><span class="why-n">2</span><p><b>Checked against the live API.</b> Every lesson shows the day its facts were last checked.</p></li>
      <li><span class="why-n">3</span><p><b>Labs that can't cost you money.</b> They use testnet, read-only calls or recorded data, and keys made in your browser.</p></li>
      <li><span class="why-n">4</span><p><b>Open source.</b> Code under MIT, writing under CC BY 4.0. Spot a mistake? <a href="https://github.com/vignesh-chaturvedi/zerotohype/issues">Open an issue</a>.</p></li>
    </ol>
  </section>
</Base>

<script>
  import "../scripts/board.ts";
  import { wireMotionButtons } from "../scripts/motion.ts";

  wireMotionButtons();

  // The roadmap index: the drawing on the right follows the row in the middle of the screen while
  // scrolling, or the row under the pointer. Instead of swapping at once, the panel eases towards
  // that row like a reel: the next drawing slides up and fades in as the last one leaves.
  const rows = [...document.querySelectorAll<HTMLAnchorElement>(".row[data-code]")];
  const byCode = new Map([...document.querySelectorAll<HTMLElement>(".pv[data-code]")].map((p) => [p.dataset.code!, p]));
  const panes = rows.map((r) => byCode.get(r.dataset.code!)!).filter(Boolean);
  const index = document.querySelector<HTMLElement>(".index");
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (index && matchMedia("(min-width: 981px)").matches && panes.length === rows.length) {
    let target = 0, current = 0, hovered = -1, live = -1, raf = 0, last = 0;

    const motion = (i: number, on: boolean) =>
      panes[i]?.querySelector("svg[data-kind]")?.dispatchEvent(new CustomEvent("motion", { detail: on }));

    function paint() {
      panes.forEach((p, i) => {
        const d = i - current, a = Math.abs(d);
        if (a >= 1) {
          p.style.visibility = "hidden";
          p.style.opacity = "0";
          return;
        }
        p.style.visibility = "visible";
        p.style.opacity = String(Math.max(0, 1 - a * 1.3));
        p.style.transform = `translateY(${(d * 36).toFixed(2)}px)`;
        p.style.zIndex = String(10 - Math.round(a * 5));
      });
      const near = Math.round(current);
      if (near !== live) {
        motion(live, false);
        motion(near, true);
        live = near;
      }
    }

    function tick(now: number) {
      const dt = last ? Math.min(64, now - last) : 16;
      last = now;
      current += (target - current) * (1 - Math.exp(-dt / 170));
      if (Math.abs(target - current) < 0.003) current = target;
      paint();
      if (current === target) { raf = 0; last = 0; }
      else raf = requestAnimationFrame(tick);
    }

    function aim(i: number) {
      if (i === target) return;
      target = i;
      rows.forEach((r, j) => r.classList.toggle("is-active", j === i));
      if (still) { current = target; paint(); return; }
      if (!raf) raf = requestAnimationFrame(tick);
    }

    // The row whose middle is closest to the middle of the screen.
    function nearest() {
      const mid = innerHeight / 2;
      let best = 0, gap = Infinity;
      rows.forEach((r, i) => {
        const b = r.getBoundingClientRect();
        const d = Math.abs(b.top + b.height / 2 - mid);
        if (d < gap) { gap = d; best = i; }
      });
      return best;
    }

    rows.forEach((r, i) => {
      r.addEventListener("pointerenter", () => { hovered = i; aim(i); });
      r.addEventListener("focus", () => aim(i));
    });
    // Near the end of the list the sticky panel runs out of room and would slide under the header.
    // Below the list, beside the next section's heading, the column is empty, so the panel is nudged
    // down into that space (up to 240 px) and stays in view a little longer.
    const preview = index.querySelector<HTMLElement>(".preview");
    const header = document.querySelector<HTMLElement>("header.site");
    let shift = 0;
    function keepInView() {
      if (!preview) return;
      const top = preview.getBoundingClientRect().top - shift;
      const min = (header?.getBoundingClientRect().bottom ?? 0) + 16;
      const next = Math.round(Math.max(0, Math.min(240, min - top)));
      if (next !== shift) {
        shift = next;
        preview.style.translate = shift ? `0 ${shift}px` : "";
      }
    }

    index.addEventListener("pointerleave", () => { hovered = -1; });
    addEventListener("scroll", () => { hovered = -1; aim(nearest()); keepInView(); }, { passive: true });
    addEventListener("resize", keepInView, { passive: true });
    keepInView();

    rows[0].classList.add("is-active");
    paint();
  }
</script>

<style>
  /* Stage: the headline on the left, a departure board of live prices on the right. */
  .stage { border-bottom: 4px solid var(--ink); }
  .stage-grid { display: grid; grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr); gap: 40px 56px; align-items: center; padding-block: clamp(36px, 7vh, 88px) clamp(40px, 7vh, 88px); }
  .stage-copy { display: grid; justify-items: start; gap: 24px; }
  .stage h1 { font-size: clamp(2.9rem, 6.6vw, 5.9rem); line-height: 1; letter-spacing: -0.045em; font-weight: 900; max-width: 11.5em; }
  .stage h1 em {
    font-style: normal; color: var(--on-signal); padding: 0 0.1em; margin-inline: -0.02em;
    background: linear-gradient(var(--signal), var(--signal)) 0 0.11em / 100% 1.02em no-repeat;
    -webkit-box-decoration-break: clone; box-decoration-break: clone;
  }
  @media (forced-colors: active) { .stage h1 em { forced-color-adjust: none; } }
  .stage .lede { max-width: 50ch; }
  .ctas { display: flex; flex-wrap: wrap; gap: 10px; }

  /* The board is always lit, whatever the page's theme: a black case, flaps in two greys, white figures. */
  .board {
    --flap-top: #2a2a2a; --flap-bottom: #222222; --board-ink: #f6f6f6; --board-muted: #9ea0a1;
    display: grid; gap: 0; min-width: 0; padding: 0 0 4px; border-radius: var(--r); background: #0f0f0f; color: var(--board-ink);
    box-shadow: 0 0 0 1px #000;
  }
