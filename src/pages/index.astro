---
import Base from "../layouts/Base.astro";
---

<Base title="Zero to HYPE" description="A free, open-source roadmap for building on Hyperliquid.">
  <section class="intro">
    <p class="eyebrow">Free and open source</p>
    <h1>Zero to HYPE</h1>
    <p class="lede">A roadmap for building on Hyperliquid, from your first API call to running a perp DEX or settling outcome markets.</p>
  </section>
</Base>

<style>
  .intro { display: grid; gap: 14px; }
  .lede { font-size: 1.15rem; max-width: 62ch; }
</style>
