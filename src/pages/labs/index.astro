---
import Base from "../../layouts/Base.astro";
import TrackCover from "../../components/TrackCover.astro";
import Station from "../../components/Station.astro";
import { lineStyle, type Motif } from "../../lib/track-look";
import settlements from "../../../public/data/hip4-settlements.json";

const labs: { n: string; code: string; href: string; title: string; track: string; note: string; what: string; motif?: Motif; kind?: string }[] = [
  {
    n: "01",
    code: "T3",
    href: "/labs/sign-without-money/",
    title: "Sign without money",
    track: "T3 Signing and sending",
    note: "Testnet · throwaway key",
    what: "Sign an action with a key made in your browser and let the exchange tell you whether your encoding is right. Then break it on purpose, one common bug at a time.",
  },
  {
    n: "02",
    code: "T4",
    href: "/labs/funding/",
    title: "Funding and mark price",
    track: "T4 Trading mechanics",
    note: "Mainnet · read-only",
    what: "Live oracle, mark and impact prices for any perp, with the premium and funding rate worked out in front of you and checked against the API's own number.",
  },
  {
    n: "03",
    code: "T8",
    href: "/labs/settlement/",
    title: "Settlement explorer",
    track: "T8 Outcome markets",
    note: `${settlements.markets.length} real settlements`,
    what: "Recompute real HIP-4 settlements from the prices hyperkeeper recorded, and see which kind of average each venue really uses.",
  },
  {
    n: "04",
    code: "T2",
    href: "/labs/order-book/",
    title: "Live order book",
    track: "T2 Reading the exchange",
    note: "Mainnet · live feed",
    what: "Any perp or spot pair's book, streamed from the WebSocket. Change how it's grouped and how often it comes, see the messages themselves, and work out what a market order would cost.",
  },
  {
    n: "05",
    code: "T2",
    href: "/labs/tick-and-lot/",
    title: "Tick and lot sizes",
    track: "T2 Reading the exchange",
    note: "Mainnet · read-only",
    what: "Type a price and a size and see whether the exchange would take them, the nearest values it would, and code in three languages that rounds them.",
    motif: "ticks",
    kind: "Workbench",
  },
  {
    n: "06",
    code: "T4",
    href: "/labs/liquidation-price/",
    title: "Margin and liquidation price",
    track: "T4 Trading mechanics",
    note: "Mainnet · read-only",
    what: "Work out a position's margin and liquidation price, margin tiers included, then check the formula against the liquidation prices the API reports for real positions.",
    motif: "liq",
    kind: "Workbench",
  },
];
---

<Base title="Hyperliquid labs that run in your browser" heading="Labs that run on the real API." trail={[["Labs", "/labs/"]]} description="Hands-on Hyperliquid labs that run in your browser against the live API. No funds, no real keys.">
  <header class="page-head">
    <p class="eyebrow">Labs</p>
    <h1>Labs that run on the <em>real API.</em></h1>
    <p class="lede">
      Each lab runs in your browser and talks to Hyperliquid's API directly. None needs funds or a
      real key, and none can change anything on the exchange.
    </p>
  </header>
  <ol class="labs">
    {labs.map((lab) => (
      <li>
        <a class="lab-card" href={lab.href} style={lineStyle(lab.code)}>
          <TrackCover code={lab.code} label={lab.note} num={lab.n} motif={lab.motif} />
          <span class="lab-body">
            <span class="lab-top"><span class="eyebrow">{lab.kind ?? "Lab"} {lab.n} · {lab.track}</span><span class="tag ok">Live</span></span>
            <span class="lab-title">{lab.title}</span>
            <span class="lab-what">{lab.what}</span>
            <span class="lab-go"><Station code={lab.code} size="s" />Open the lab <span aria-hidden="true">→</span></span>
          </span>
        </a>
      </li>
    ))}
  </ol>
  <p class="more muted">
    More are on the way, among them a CoreWriter encoder, a fee tier workbench and a builder code fee
    calculator. Each track's page lists what it will get.
  </p>
</Base>

<style>
  .labs { list-style: none; margin: 0; padding: 0; display: grid; gap: 20px; }
  /* Each lab is a sign: its track's painted panel on the left, the words on white beside it. */
  .lab-card {
    display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); align-items: stretch;
    border: 2px solid var(--ink); border-radius: var(--r); overflow: hidden; text-decoration: none; color: var(--ink); background: var(--surface);
    transition: box-shadow 160ms var(--ease);
  }
  .lab-card:hover { box-shadow: 8px 8px 0 var(--c); }
  .lab-card :global(.cover) { border-radius: 0; height: 100%; min-height: 240px; }
  .lab-body { display: grid; gap: 12px; align-content: center; padding: 24px 28px 26px; }
  .lab-top { display: flex; justify-content: space-between; gap: 10px; align-items: center; flex-wrap: wrap; }
  .lab-title { font: 900 clamp(1.9rem, 3.8vw, 2.7rem)/1 var(--display); letter-spacing: -0.035em; }
  .lab-what { color: var(--ink-2); max-width: 54ch; }
  .lab-go { display: flex; align-items: center; gap: 10px; font-weight: 800; }
  .lab-card:hover .lab-go { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 4px; }
  .more { max-width: 66ch; font-size: 1rem; }
  @media (max-width: 760px) {
    .lab-card { grid-template-columns: minmax(0, 1fr); }
    .lab-card :global(.cover) { min-height: 0; height: auto; }
    .lab-body { padding: 18px 18px 20px; }
  }
</style>
