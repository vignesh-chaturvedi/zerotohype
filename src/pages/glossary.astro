---
import Base from "../layouts/Base.astro";
import { terms, termId } from "../data/glossary";
import { inlineMd } from "../lib/inline-md";

// Alphabetical, ignoring case, then grouped by first letter.
const sorted = [...terms].sort((a, b) => a.term.localeCompare(b.term, "en", { sensitivity: "base" }));
const groups = new Map<string, typeof terms>();
for (const t of sorted) {
  const letter = t.term[0].toUpperCase();
  groups.set(letter, [...(groups.get(letter) ?? []), t]);
}
---

<Base title="Hyperliquid glossary" heading="The terms, in plain words." trail={[["Glossary", "/glossary/"]]} description={`${terms.length} Hyperliquid terms in plain words, from activation fee to WHYPE, each linked to where it's explained properly.`}>
  <div style="display: contents" data-pagefind-body data-pagefind-meta="kind:Reference">
  <header class="page-head">
    <p class="eyebrow">Reference</p>
    <h1>The terms, in <em>plain words.</em></h1>
    <p class="lede">
      The words you'll meet building on Hyperliquid, each in a sentence or two, with a link to
      where a lesson or the docs explain it properly.
    </p>
  </header>

  <div class="glossary">
    <nav class="letters" aria-label="Jump to a letter" data-pagefind-ignore>
      {[...groups.keys()].map((l) => <a href={`#letter-${l.toLowerCase()}`}>{l}</a>)}
    </nav>

    {[...groups].map(([letter, list]) => (
      <section class="group" aria-labelledby={`letter-${letter.toLowerCase()}`}>
        <h2 class="letter" id={`letter-${letter.toLowerCase()}`} data-pagefind-ignore>{letter}</h2>
        <div class="terms">
          {list.map((t) => (
            <div class="term">
              <div class="name">
                <h3 id={termId(t.term)}>{t.term}</h3>
                {t.aka && <p class="aka">{t.aka.join(" · ")}</p>}
              </div>
              <div class="body">
                <p set:html={inlineMd(t.def)} />
                {t.see && (
                  <p class="see" data-pagefind-ignore>
                    {t.see.map(([label, href]) => <a href={href}>{label}</a>)}
                  </p>
                )}
              </div>
            </div>
          ))}
        </div>
      </section>
    ))}

    <p class="missing" data-pagefind-ignore>
      A term missing, or explained wrong?{" "}
      <a href="https://github.com/vignesh-chaturvedi/zerotohype/issues/new">Open an issue</a> and say which.
    </p>
  </div>
  </div>
</Base>

<style>
  .glossary { display: grid; grid-template-columns: minmax(0, 1fr); gap: 40px; max-width: 940px; }

  /* A–Z, each letter a link to its group: square plates, as on a platform's exit signs. */
  .letters { display: flex; flex-wrap: wrap; gap: 6px; }
  .letters a {
    display: grid; place-items: center; min-width: 40px; height: 40px; padding: 3px 8px 0; border-radius: var(--r);
    background: var(--plate); color: var(--on-band);
    font: 900 1rem/1 var(--display); text-decoration: none; transition: background 150ms var(--ease), color 150ms var(--ease);
  }
  .letters a:hover { background: var(--signal); color: var(--on-signal); }

  .group { display: grid; grid-template-columns: 4.5rem minmax(0, 1fr); gap: 0 22px; align-items: start; }
  .letter { position: sticky; top: calc(var(--head-h) + 16px); display: grid; place-items: center; width: 56px; height: 56px; padding-top: 6px; margin: 0; border-radius: var(--r); background: var(--signal); color: var(--on-signal); font: 900 2rem/1 var(--display); scroll-margin-top: 8px; }
  .terms { display: grid; }

  /* One row per term: the name on the left, what it means on the right */
  /* Each term has a rule above it, so the gap between two letters has one line, not two. */
  .term { display: grid; grid-template-columns: 14rem minmax(0, 1fr); gap: 6px 24px; padding: 16px 0; border-top: 1px solid var(--rule); }
  .term:first-child { border-top: 4px solid var(--ink); }
  .term h3 { margin: 0; font: 800 1.125rem/1.35 var(--display); overflow-wrap: anywhere; scroll-margin-top: 12px; }
  .term h3:target { text-decoration: underline 4px var(--signal); text-underline-offset: 4px; }
  .term:has(h3:target) { box-shadow: inset 6px 0 0 var(--signal); padding-left: 16px; }
  .aka { margin: 4px 0 0; font: 400 0.875rem/1.45 var(--body); color: var(--muted); }
  .body { display: grid; gap: 8px; min-width: 0; }
  .body p { margin: 0; font-size: 1rem; line-height: 1.6; color: var(--ink-2); max-width: 64ch; }
  .body .see { display: flex; flex-wrap: wrap; gap: 4px 14px; font-size: 0.875rem; font-weight: 700; }
  .see a { color: var(--accent); text-underline-offset: 3px; }
  .see a::after { content: " →" / ""; } /* decorative: screen readers skip it */

  .missing { margin: 0; font-size: 0.9375rem; color: var(--muted); }
  @media (forced-colors: active) { .letters a, .letter { border: 1px solid CanvasText; } }

  @media (max-width: 760px) {
    .group { grid-template-columns: minmax(0, 1fr); gap: 10px; }
    .letter { position: static; width: 44px; height: 44px; font-size: 1.5rem; }
    .term { grid-template-columns: minmax(0, 1fr); }
  }
</style>
