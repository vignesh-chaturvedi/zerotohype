---
import Base from "../layouts/Base.astro";
import entries from "../data/changelog.json";
import meta from "../data/changelog-meta.json";
import { freshness } from "../lib/freshness";
import { entryId, inlineHtml as inline, type Entry } from "../lib/changelog";

const day = (iso: string) =>
  new Date(iso).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });
const groups = new Map<string, Entry[]>();
for (const e of entries as Entry[]) {
  const key = day(e.time);
  groups.set(key, [...(groups.get(key) ?? []), e]);
}
const since = day(meta.trackingSince);
const lastRun = new Date(meta.lastRun).toLocaleString("en-GB", { dateStyle: "medium", timeStyle: "short", timeZone: "UTC" });
const c = meta.counts;
const filters = [["all", "All"], ["mainnet", "Mainnet"], ["testnet", "Testnet"], ["docs", "Docs"]] as const;
---

<Base title="Changelog" description="What changed in Hyperliquid's API, detected automatically from mainnet, testnet and the docs.">
  <div style="display: contents" data-pagefind-body data-pagefind-meta="kind:Changelog">
  <header class="page-head">
    <p class="eyebrow">API changelog</p>
    <h1>What changed in <em>Hyperliquid.</em></h1>
    <p class="lede">
      Hyperliquid ships API changes before it documents them and publishes no changelog. A job
      checks mainnet, testnet and the docs every 6 hours and records what changed: new perps and
      HIP-3 DEXs, permission grants, HIP-4 venues and templates, and edited docs pages.
    </p>
    <p class="pill run-note" data-checked={meta.lastRun} data-fresh="0.5,1" data-state={freshness(Date.parse(meta.lastRun), 0.5, 1)}>
      <span class="live-dot"></span>Tracking since {since} · last checked <b><time datetime={meta.lastRun}>{lastRun} UTC</time></b><span class="ago" data-ago></span>
    </p>
    <p class="follow"><a href="/changelog/rss.xml">Follow it by RSS</a>: each change arrives as it's found.</p>
  </header>

  <section class="now" aria-labelledby="now-title">
    <h2 id="now-title" class="eyebrow">Right now</h2>
    <div class="counts">
      <table>
        <thead><tr><th scope="col"><span class="visually-hidden">Count</span></th><th scope="col">Mainnet</th><th scope="col">Testnet</th></tr></thead>
        <tbody>
          <tr><th scope="row">Listed perps on the main DEX</th><td>{c.mainnet.perps}</td><td>{c.testnet.perps}</td></tr>
          <tr><th scope="row">HIP-3 DEXs</th><td>{c.mainnet.dexs}</td><td>{c.testnet.dexs}</td></tr>
          <tr><th scope="row">HIP-4 venues with live outcomes</th><td>{c.mainnet.venues}</td><td>{c.testnet.venues}</td></tr>
          <tr><th scope="row">Outcome templates</th><td>{c.mainnet.templates}</td><td>{c.testnet.templates}</td></tr>
        </tbody>
      </table>
    </div>
    <p class="note">The docs have {c.docs.pages} pages outside the FAQ.</p>
  </section>

  <section class="log" aria-labelledby="log-title">
    <h2 id="log-title">Changes</h2>
    <div class="filter" role="group" aria-label="Show changes from" data-filter hidden data-pagefind-ignore>
      {filters.map(([net, name]) => <button type="button" data-net={net} aria-pressed={net === "all" ? "true" : "false"}>{name}</button>)}
    </div>
    <p class="empty" data-none hidden>Nothing from there yet.</p>
    {groups.size === 0 ? (
      <p class="empty">
        No changes yet. Tracking started on {since}; anything that changes after that appears here,
        newest first.
      </p>
    ) : (
      [...groups.entries()].map(([date, items]) => (
        <div class="day">
          <h3>{date}<span data-count>{items.length} {items.length === 1 ? "change" : "changes"}</span></h3>
          <ul>
            {items.map((e) => (
              <li data-net={e.network} id={entryId(e)}>
                <span class="meta"><span class={`net ${e.network}`}>{e.network}</span>{e.area !== e.network && <span class="area">{e.area}</span>}</span>
                <span class="text" set:html={inline(e.summary)} />
              </li>
            ))}
          </ul>
        </div>
      ))
    )}
  </section>
  </div>
</Base>

<script>
  // Shows the changes from one network, or all of them; the choice is kept in this browser.
  const KEY = "zth:changelog-net";
  const bar = document.querySelector<HTMLElement>("[data-filter]");
  const none = document.querySelector<HTMLElement>("[data-none]");
  if (bar) {
    bar.hidden = false;
    const days = [...document.querySelectorAll<HTMLElement>(".day")];
    const show = (net: string) => {
      for (const b of bar.querySelectorAll<HTMLButtonElement>("button")) b.setAttribute("aria-pressed", String(b.dataset.net === net));
      let any = false;
      for (const day of days) {
        const items = [...day.querySelectorAll<HTMLElement>("li[data-net]")];
        let shown = 0;
        for (const li of items) {
          li.hidden = !(net === "all" || li.dataset.net === net);
          if (!li.hidden) shown++;
        }
        day.hidden = shown === 0;
        any ||= shown > 0;
        const count = day.querySelector<HTMLElement>("[data-count]");
        const total = items.length;
        if (count) count.textContent = shown === total ? `${total} ${total === 1 ? "change" : "changes"}` : `${shown} of ${total} changes`;
      }
      if (none) none.hidden = any || days.length === 0;
      try { localStorage.setItem(KEY, net); } catch {}
    };
    bar.addEventListener("click", (e) => {
      const b = (e.target as Element).closest<HTMLButtonElement>("button[data-net]");
      if (b?.dataset.net) show(b.dataset.net);
    });
    let saved: string | null = null;
    try { saved = localStorage.getItem(KEY); } catch {}
    // A link to one change (from the feed) shows everything, so the change it points at isn't filtered out.
    const target = location.hash ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null;
    const hidesTarget = target?.dataset.net && saved !== target.dataset.net;
    if (saved && saved !== "all" && !hidesTarget && bar.querySelector(`button[data-net="${saved}"]`)) show(saved);
  }
</script>

<style>
  .run-note { justify-self: start; }
  .note { font-size: 0.8125rem; color: var(--muted); }
  .now, .log { display: grid; gap: 16px; }
  .counts { max-width: 680px; border: 1px solid var(--rule); border-radius: 18px; background: var(--surface); box-shadow: var(--shadow); overflow: hidden; }
  .counts table { width: 100%; border-collapse: collapse; font-size: 0.9375rem; }
  .counts :is(th, td) { padding: 12px 0 12px 12px; border-bottom: 1px solid var(--rule); text-align: left; vertical-align: baseline; font-weight: 400; }
  .counts :is(th, td):first-child { padding-left: 18px; }
  .counts :is(th, td):last-child { padding-right: 18px; }
  .counts tbody tr:last-child > * { border-bottom: 0; }
  .counts td, .counts thead th + th { width: 6rem; text-align: right; }
  .counts td { font: 500 1.15rem/1 var(--data); letter-spacing: -0.04em; font-variant-numeric: tabular-nums; }
  .counts thead th { background: var(--sunk); font: 500 0.75rem/1.4 var(--data); letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  .log h2 { font-size: clamp(1.6rem, 3.4vw, 2.2rem); }
  .empty { color: var(--muted); max-width: 64ch; }
  .day { display: grid; grid-template-columns: 9rem minmax(0, 1fr); gap: 12px 24px; align-items: start; padding-top: 18px; border-top: 1px solid var(--rule); }
  .day h3 { display: grid; gap: 4px; font: 500 0.875rem/1.3 var(--data); letter-spacing: -0.02em; position: sticky; top: 84px; }
  .day h3 span { font: 400 0.75rem/1.3 var(--data); color: var(--muted); letter-spacing: 0; }
  .day ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .day li { display: grid; grid-template-columns: 11rem minmax(0, 1fr); gap: 12px; align-items: baseline; padding: 11px 14px; background: var(--surface); border: 1px solid var(--rule); border-radius: 12px; font-size: 0.90625rem; }
  .meta { display: flex; gap: 10px; }
  .net, .area { font: 500 0.75rem/1.4 var(--data); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .net.mainnet { color: var(--accent); }
  .text { overflow-wrap: anywhere; }
  .day li { scroll-margin-top: 16px; }
  .day li:target { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent); }
  .follow { font-size: 0.875rem; color: var(--muted); }
  .filter { display: flex; flex-wrap: wrap; gap: 6px; }
  .filter button { padding: 8px 12px; border: 1px solid var(--rule-strong); border-radius: 999px; background: var(--surface); color: var(--ink-2); font: 500 0.75rem/1 var(--data); letter-spacing: 0.08em; text-transform: uppercase; cursor: pointer; }
  .filter button:hover { border-color: var(--ink-2); color: var(--ink); }
  .filter button[aria-pressed="true"] { border-color: var(--ink); background: var(--ink); color: var(--bg); }
  /* In high contrast mode the pressed filter takes the system's highlight colours; it opts out of the
     mode's own colouring, which would draw a backplate behind its text in the same colour as the text. */
  @media (forced-colors: active) { .filter button[aria-pressed="true"] { forced-color-adjust: none; background: Highlight; color: HighlightText; border-color: Highlight; } }
  .filter[hidden], .day[hidden], .day li[hidden], .empty[hidden] { display: none; }
  @media (max-width: 760px) {
    .day { grid-template-columns: minmax(0, 1fr); }
    .day h3 { position: static; display: flex; gap: 10px; align-items: baseline; }
    .day li { grid-template-columns: minmax(0, 1fr); gap: 4px; }
    .counts :is(th, td) { padding-block: 11px; }
    .counts :is(th, td):first-child { padding-left: 14px; }
    .counts :is(th, td):last-child { padding-right: 14px; }
    .counts td, .counts thead th + th { width: 4.2rem; }
  }
</style>
