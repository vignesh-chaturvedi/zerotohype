---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import TrackCover from "../../components/TrackCover.astro";
import Station from "../../components/Station.astro";
import { lineStyle } from "../../lib/track-look";
import { freshness } from "../../lib/freshness";
import { editedSince } from "../../lib/source-changes";
import { page } from "../../lib/structured-data";

export async function getStaticPaths() {
  const tracks = (await getCollection("tracks")).sort((a, b) => a.data.order - b.data.order);
  const all = tracks.map((t) => ({ id: t.id, code: t.data.code, title: t.data.title, stage: t.data.stage, depth: t.data.depth }));
  return tracks.map((track, i) => ({
    params: { id: track.id },
    props: { track, prev: tracks[i - 1], next: tracks[i + 1], all },
  }));
}

const { track, prev, next, all } = Astro.props;
const { Content, headings } = await render(track);
const t = track.data;
const kindLabel = { lab: "Lab", workbench: "Workbench", project: "Project", guide: "Guide" } as const;
const verified = t.verified?.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });
const stages = [...new Set(all.map((a) => a.stage))];
const position = all.findIndex((a) => a.id === track.id) + 1;
// The lesson's sections, how long it takes to read, and the live labs to try once it's read.
const sections = headings.filter((h) => h.depth === 2);
const minutes = Math.max(1, Math.round((track.body ?? "").split(/\s+/).filter(Boolean).length / 220));
const tryNext = t.build.filter((b) => b.status === "live" && b.href);
const editUrl = `https://github.com/vignesh-chaturvedi/zerotohype/edit/main/src/content/tracks/${track.id}.md`;
// Cited docs pages that the changelog bot saw edited after the lesson was checked.
const changed = t.verified ? editedSince(t.docs, t.verified) : [];
// What search engines are told: a lesson is an article modified when its facts were last checked;
// a reading list is a collection of links.
const name = `${t.code} ${t.title}`;
const path = `/tracks/${track.id}/`;
const lesson = t.depth === "lesson";
const data = [page(lesson ? "TechArticle" : "CollectionPage", path, { name, headline: t.seoTitle ?? name, description: t.summary, modified: t.verified, section: lesson ? t.stage : undefined })];
const list = (xs: string[]) => (xs.length < 2 ? xs.join("") : `${xs.slice(0, -1).join(", ")} and ${xs.at(-1)}`);
const editDays = list([...new Set(changed.map((c) => new Date(c.time).toLocaleDateString("en-GB", { day: "numeric", month: "short", timeZone: "UTC" })))].reverse());
---

<Base title={t.seoTitle ?? name} heading={t.title} description={t.summary} trail={[[name, path]]} data={data} modified={lesson ? t.verified : undefined} markdown={`/tracks/${track.id}.md`}>
  <div class="layout" style={lineStyle(t.code)}>
    <nav class="side" aria-label="Roadmap">
      <p class="eyebrow">The roadmap</p>
      <p class="side-key" aria-hidden="true">
        <span><span class="side-dot lesson"></span>Lesson</span>
        <span><span class="side-dot"></span>Reading list</span>
      </p>
      {stages.map((stage) => (
        <div class="side-group">
          <p class="side-stage">{stage}</p>
          <ol>
            {all.filter((a) => a.stage === stage).map((a) => (
              <li>
                <a href={`/tracks/${a.id}/`} aria-current={a.id === track.id ? "page" : undefined} data-done-id={a.id} style={lineStyle(a.code)}>
                  <Station code={a.code} size="s" />
                  <span class="side-title"><span class="visually-hidden">{a.code} </span>{a.title}</span>
                  <span class={`side-dot ${a.depth}`} title={a.depth === "lesson" ? "Lesson" : "Reading list"} />
                  <span class="side-tick" title="Done"><svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2.6 6.3 5 8.6 9.6 3.6" /></svg><span class="visually-hidden">(done)</span></span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      ))}
    </nav>

    <div class="main" data-pagefind-body data-pagefind-meta={`kind:Track ${t.code} · ${t.stage}`}>
      <details class="mobile-map" data-pagefind-ignore>
        <summary><span class="eyebrow">Roadmap</span> <span>{t.code} of 10 · all tracks</span></summary>
        <ol>
          {all.map((a) => (
            <li><a href={`/tracks/${a.id}/`} aria-current={a.id === track.id ? "page" : undefined}><span class="side-code">{a.code}</span> {a.title}</a></li>
          ))}
        </ol>
      </details>

      <div data-pagefind-ignore><TrackCover code={t.code} variant="banner" label={t.stage} /></div>

      <header class="head">
        <p class="eyebrow">{t.code} · {t.stage} · {position} of {all.length}</p>
        <h1>{t.title}</h1>
        <p class="lede">{t.summary}</p>
        <p class="status">
          {t.depth === "lesson" ? <span class="tag ok">Lesson</span> : <span class="tag">Reading list</span>}
          {t.verified ? (
            <span class="pill" data-checked={t.verified.toISOString()} data-state={freshness(t.verified.getTime())}>
              <span class="live-dot" />Checked against the live API · <b><time datetime={t.verified.toISOString().slice(0, 10)}>{verified}</time></b><span class="ago" data-ago />
            </span>
          ) : null}
        </p>
        {/* What the reader can do with the page, on a row of their own. */}
        <div class="page-actions" data-pagefind-ignore>
          {/* One name for both states; aria-pressed says whether it's done, while the visible label changes to "Done". */}
          <button class="done-btn" type="button" data-done-toggle={track.id} aria-pressed="false" aria-label="Mark as done" data-pagefind-ignore>
            <span class="tick"><svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2.6 6.3 5 8.6 9.6 3.6" /></svg></span>
            <span class="done-label">Mark as done</span>
          </button>
          {/* Copies the Markdown version below (/tracks/<id>.md), for an assistant; shown where the browser can copy. */}
          <button class="md-btn" type="button" data-copy-md={`/tracks/${track.id}.md`} aria-live="polite" hidden data-pagefind-ignore>Copy as Markdown</button>
        </div>
        {changed.length > 0 && (
          <p class="source-note" data-pagefind-ignore>
            Since this was checked, the docs changed {changed.length === 1 ? "a page" : `${changed.length} pages`} it relies on:{" "}
            {changed.map((c, i) => (
              <>{i > 0 && (i === changed.length - 1 ? " and " : ", ")}<a href={c.url}>{c.title}</a></>
            ))}{" "}
            ({editDays}). Until it's re-checked, compare with {changed.length === 1 ? "that page" : "those pages"}; <a href="/changelog/">the changelog</a> lists every edit.
          </p>
        )}
      </header>

      <div class="reading">
        <section>
          <p class="eyebrow"><span class="n">01</span> Read first</p>
          <p class="muted">The official docs for this track.</p>
          <ul>
            {t.docs.map((d) => <li><a href={d.url}>{d.title}</a>{d.note && <>{" "}<span class="note">{d.note}</span></>}</li>)}
          </ul>
        </section>
        {t.outside.length > 0 && (
          <section>
            <p class="eyebrow"><span class="n">02</span> Then</p>
            <p class="muted">Tutorials and write-ups worth your time.</p>
            <ul>
              {t.outside.map((d) => (
                <li><a href={d.url}>{d.title}</a>{d.by && <>{" "}<span class="by">{d.by}</span></>}{d.note && <>{" "}<span class="note">{d.note}</span></>}</li>
              ))}
            </ul>
          </section>
        )}
        {t.build.length > 0 && (
          <section class="build">
            <p class="eyebrow"><span class="n">{t.outside.length > 0 ? "03" : "02"}</span> Build</p>
            <p class="muted">Hands-on work for this track.</p>
            <ul>
              {[...t.build].sort((a, b) => Number(a.status !== "live") - Number(b.status !== "live")).map((b) => (
                <li>
                  {b.href && b.status === "live" ? <a href={b.href}>{kindLabel[b.kind]}: {b.label}</a> : <span>{kindLabel[b.kind]}: {b.label}</span>}{" "}
                  {b.status === "planned" ? <span class="tag">Coming</span> : <span class="tag ok">Live</span>}
                </li>
              ))}
            </ul>
            {t.build.some((b) => b.status === "planned") && (
              <p class="muted" data-pagefind-ignore>Want one of these sooner? <a href="https://github.com/vignesh-chaturvedi/zerotohype/issues">Say so on GitHub</a>.</p>
            )}
          </section>
        )}
      </div>

      {sections.length > 2 && (
        <nav class="toc" aria-labelledby="toc-title" data-pagefind-ignore>
          <p class="eyebrow" id="toc-title">On this page · {minutes} min read</p>
          <ol>{sections.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </nav>
      )}

      <article class="prose">
        <Content />
      </article>

      {tryNext.length > 0 && (
        <aside class="try-next" aria-labelledby="try-title" data-pagefind-ignore>
          <p class="eyebrow" id="try-title">Now try it</p>
          {tryNext.map((b) => <a href={b.href}>{kindLabel[b.kind]}: {b.label} <span aria-hidden="true">→</span></a>)}
        </aside>
      )}

      <p class="edit" data-pagefind-ignore>
        Spot a mistake or something out of date?{" "}
        <a href={editUrl}>Edit this page on GitHub</a> or <a href="https://github.com/vignesh-chaturvedi/zerotohype/issues/new">open an issue</a>.
      </p>

      <nav class="pager" aria-label="Tracks" data-pagefind-ignore>
        {prev ? (
          <a href={`/tracks/${prev.id}/`} style={lineStyle(prev.data.code)}>
            <span class="eyebrow">← Previous stop</span>
            <span class="pager-title"><Station code={prev.data.code} size="s" /><span><span class="visually-hidden">{prev.data.code} </span>{prev.data.title}</span></span>
          </a>
        ) : <span />}
        {next ? (
          <a class="end" href={`/tracks/${next.id}/`} style={lineStyle(next.data.code)}>
            <span class="eyebrow">Next stop →</span>
            <span class="pager-title"><span><span class="visually-hidden">{next.data.code} </span>{next.data.title}</span><Station code={next.data.code} size="s" /></span>
          </a>
        ) : <span />}
      </nav>
    </div>
  </div>
</Base>

<script>
  import "../../scripts/code-blocks.ts";
  import "../../scripts/copy-markdown.ts";
</script>

<style>
  .layout { display: grid; grid-template-columns: 260px minmax(0, 1fr); gap: 56px; align-items: start; }
  .main { display: grid; grid-template-columns: minmax(0, 1fr); gap: 32px; min-width: 0; }

  /* The roadmap beside the lesson, drawn as a line diagram: a black line through every station, and the
     one you're at named on a black plate, as a station's own sign is. */
  .side { position: sticky; top: 84px; display: grid; gap: 18px; max-height: calc(100vh - 110px); overflow-y: auto; padding: 2px 6px 8px 2px; }
  .side-group { display: grid; gap: 4px; }
  .side-stage { font: 800 0.75rem/1.3 var(--body); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); padding-left: 44px; }
  .side ol { position: relative; list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
  .side ol::before { content: ""; position: absolute; left: 13px; top: 16px; bottom: 16px; width: 4px; background: var(--ink); }
  .side a {
    position: relative; display: grid; grid-template-columns: 30px minmax(0, 1fr) auto; gap: 14px; align-items: center;
    padding: 4px 4px 4px 0; text-decoration: none; color: var(--ink-2); font-size: 0.9375rem; line-height: 1.25;
  }
  .side a :global(.stn) { position: relative; transition: transform 160ms var(--ease); }
  .side a:hover { color: var(--ink); }
  .side a:hover :global(.stn) { transform: scale(1.1); }
  .side-title { padding: 5px 0 2px; }
  .side a:hover .side-title { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 3px; }
  .side a[aria-current="page"] { color: var(--on-band); font-weight: 800; }
  .side a[aria-current="page"] .side-title { margin-left: -6px; padding: 6px 8px 3px; border-radius: 2px; background: var(--band); box-shadow: inset 0 -4px 0 var(--c); }
  .side a[aria-current="page"] :global(.stn) { transform: scale(1.18); }
  .side-dot { width: 8px; height: 8px; border-radius: 50%; border: 2px solid var(--muted); }
  .side-dot.lesson { background: var(--ok); border-color: var(--ok); }
  /* What the two dots mean; screen readers get it from each link's name instead. */
  .side-key { display: flex; flex-wrap: wrap; gap: 4px 14px; margin-top: -10px; font-size: 0.8125rem; color: var(--muted); }
  .side-key > span { display: inline-flex; align-items: center; gap: 6px; }
  .side-tick { display: none; width: 16px; height: 16px; border-radius: 50%; background: var(--ok); place-items: center; }
  .side-tick svg { width: 10px; height: 10px; fill: none; stroke: #ffffff; stroke-width: 2.6; stroke-linecap: square; }
  .side a:global(.is-done) .side-tick { display: grid; }
  .side a:global(.is-done) .side-dot { display: none; }

  .mobile-map { display: none; border: 2px solid var(--ink); border-radius: var(--r); background: var(--surface); }
  .mobile-map summary { cursor: pointer; padding: 12px 16px 10px; display: flex; gap: 10px; align-items: center; font-size: 0.9375rem; color: var(--ink-2); }
  .mobile-map ol { list-style: none; margin: 0; padding: 4px 8px 10px; display: grid; gap: 2px; }
  .mobile-map a { display: block; padding: 10px 10px 8px; border-radius: 2px; color: var(--ink-2); text-decoration: none; font-size: 0.96875rem; }
  .mobile-map a[aria-current="page"] { background: var(--band); color: var(--on-band); font-weight: 800; }
  .mobile-map .side-code { display: inline-block; min-width: 2.4em; font: 800 0.8125rem/1 var(--body); color: var(--muted); }
  .mobile-map a[aria-current="page"] .side-code { color: var(--band-muted); }
  /* High contrast mode drops backgrounds, so the current track gets a bar and a done tick the highlight colour. */
  @media (forced-colors: active) {
    .side a[aria-current="page"] .side-title, .mobile-map a[aria-current="page"] { border-left: 3px solid Highlight; }
    .side-tick { background: Highlight; }
    .side-tick svg { stroke: HighlightText; }
  }

  .head { display: grid; gap: 16px; }
  .head h1 { font-size: clamp(2.6rem, 6.4vw, 4.8rem); font-weight: 900; letter-spacing: -0.04em; line-height: 0.96; }
  .status, .page-actions { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  .md-btn {
    display: inline-flex; align-items: center; height: 40px; padding: 2px 14px 0; border-radius: var(--r); cursor: pointer;
    font: 700 0.9375rem/1 var(--body); color: var(--ink); background: transparent; border: 2px solid var(--rule-strong);
    transition: border-color 150ms var(--ease), background 150ms var(--ease);
  }
  .md-btn:hover { border-color: var(--ink); background: var(--sunk); }
  .md-btn[hidden] { display: none; }

  /* Read first, Then, Build: three signs, each titled on a black band. */
  .reading { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 14px; }
  .reading section { background: var(--surface); border: 1px solid var(--rule); border-radius: var(--r); padding: 0 18px 18px; display: grid; gap: 8px; align-content: start; min-width: 0; overflow: hidden; }
  .reading section.build { border-color: var(--c); box-shadow: inset 0 0 0 1px var(--c); }
  .reading .eyebrow { display: flex; gap: 10px; align-items: center; margin: 0 -18px 6px; padding: 11px 18px 8px; background: var(--band); color: var(--on-band); }
  .reading section.build .eyebrow { background: var(--c); color: var(--on); }
  .reading .n { display: inline-grid; place-items: center; width: 22px; height: 22px; padding-top: 2px; border-radius: 50%; background: var(--on-band); color: var(--band); font-weight: 900; letter-spacing: 0; }
  .reading section.build .n { background: var(--on); color: var(--c); }
  .reading p.muted { font-size: 0.875rem; }
  .reading ul { list-style: none; padding: 0; margin: 4px 0 0; display: grid; gap: 10px; font-size: 0.96875rem; line-height: 1.45; }
  .reading li { overflow-wrap: anywhere; display: flex; flex-wrap: wrap; gap: 4px 8px; align-items: baseline; }
  .by { color: var(--muted); font-size: 0.8125rem; font-weight: 700; }
  .reading .note { flex-basis: 100%; font-size: 0.875rem; line-height: 1.45; color: var(--muted); }
  /* On touch screens each link is a 44px-tall target: padding makes up the height, and the gaps it
     replaces go. A note is pulled back up under its link, which stays on top so its whole target works. */
  @media (pointer: coarse) {
    .reading ul { gap: 0; }
    .reading li { row-gap: 0; }
    .reading li > a { position: relative; z-index: 1; padding-block: 11.5px; }
    .reading li:has(.note) > a { margin-bottom: -8px; }
  }
  @media (forced-colors: active) { .reading .eyebrow { border-bottom: 1px solid CanvasText; } }

  /* What to do once the lesson is read: a sign in the track's colour. */
  .try-next { display: grid; gap: 10px; max-width: 70ch; padding: 16px 18px 18px; border-radius: var(--r); border: 2px solid var(--ink); border-left: 12px solid var(--c); background: var(--surface); }
  .try-next a { font: 800 1.125rem/1.3 var(--display); }
  .edit { max-width: 70ch; font-size: 0.9375rem; color: var(--muted); }
  .pager { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; padding-top: 12px; }
  .pager a { display: grid; gap: 10px; padding: 16px 18px; border: 2px solid var(--ink); border-radius: var(--r); background: var(--surface); text-decoration: none; color: var(--ink); transition: background 150ms var(--ease), color 150ms var(--ease); }
  .pager a:hover { background: var(--band); color: var(--on-band); }
  .pager a:hover .eyebrow { color: var(--band-muted); }
  .pager a.end { text-align: right; justify-items: end; }
  .pager-title { display: inline-flex; align-items: center; gap: 12px; font: 800 1.1875rem/1.2 var(--display); }
  .pager-title > span:not(.stn) { padding-top: 3px; }

  @media (max-width: 980px) {
    .layout { grid-template-columns: minmax(0, 1fr); }
    .side { display: none; }
    .mobile-map { display: block; }
  }
  @media (max-width: 560px) { .pager { grid-template-columns: minmax(0, 1fr); } .pager a.end { text-align: left; justify-items: start; } .pager a.end .pager-title { flex-direction: row-reverse; } }
</style>
