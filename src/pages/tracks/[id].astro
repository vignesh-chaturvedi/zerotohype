---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import TrackCover from "../../components/TrackCover.astro";
import { lookOf } from "../../lib/track-look";
import { freshness } from "../../lib/freshness";
import { editedSince } from "../../lib/source-changes";

export async function getStaticPaths() {
  const tracks = (await getCollection("tracks")).sort((a, b) => a.data.order - b.data.order);
  const all = tracks.map((t) => ({ id: t.id, code: t.data.code, title: t.data.title, stage: t.data.stage, depth: t.data.depth }));
  return tracks.map((track, i) => ({
    params: { id: track.id },
    props: { track, prev: tracks[i - 1], next: tracks[i + 1], all },
  }));
}

const { track, prev, next, all } = Astro.props;
const { Content, headings } = await render(track);
const t = track.data;
const kindLabel = { lab: "Lab", workbench: "Workbench", project: "Project", guide: "Guide" } as const;
const verified = t.verified?.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });
const stages = [...new Set(all.map((a) => a.stage))];
const position = all.findIndex((a) => a.id === track.id) + 1;
// The lesson's sections, how long it takes to read, and the live labs to try once it's read.
const sections = headings.filter((h) => h.depth === 2);
const minutes = Math.max(1, Math.round((track.body ?? "").split(/\s+/).filter(Boolean).length / 220));
const tryNext = t.build.filter((b) => b.status === "live" && b.href);
const editUrl = `https://github.com/vignesh-chaturvedi/zerotohype/edit/main/src/content/tracks/${track.id}.md`;
// Cited docs pages that the changelog bot saw edited after the lesson was checked.
const changed = t.verified ? editedSince(t.docs, t.verified) : [];
const list = (xs: string[]) => (xs.length < 2 ? xs.join("") : `${xs.slice(0, -1).join(", ")} and ${xs.at(-1)}`);
const editDays = list([...new Set(changed.map((c) => new Date(c.time).toLocaleDateString("en-GB", { day: "numeric", month: "short", timeZone: "UTC" })))].reverse());
---

<Base title={`${t.code} ${t.title}`} description={t.summary}>
  <div class="layout" style={`--c: ${lookOf(t.code).color}`}>
    <aside class="side" aria-label="Roadmap">
      <p class="eyebrow">The roadmap</p>
      <p class="side-key" aria-hidden="true">
        <span><span class="side-dot lesson"></span>Lesson</span>
        <span><span class="side-dot"></span>Reading list</span>
      </p>
      {stages.map((stage) => (
        <div class="side-group">
          <p class="side-stage">{stage}</p>
          <ol>
            {all.filter((a) => a.stage === stage).map((a) => (
              <li>
                <a href={`/tracks/${a.id}/`} aria-current={a.id === track.id ? "page" : undefined} data-done-id={a.id} style={`--c: ${lookOf(a.code).color}`}>
                  <span class="side-code">{a.code}</span>
                  <span class="side-title">{a.title}</span>
                  <span class={`side-dot ${a.depth}`} title={a.depth === "lesson" ? "Lesson" : "Reading list"} />
                  <span class="side-tick" title="Done"><svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2.6 6.3 5 8.6 9.6 3.6" /></svg><span class="visually-hidden">(done)</span></span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      ))}
    </aside>

    <div class="main" data-pagefind-body data-pagefind-meta={`kind:Track ${t.code} · ${t.stage}`}>
      <details class="mobile-map" data-pagefind-ignore>
        <summary><span class="eyebrow">Roadmap</span> <span>{t.code} of 10 · all tracks</span></summary>
        <ol>
          {all.map((a) => (
            <li><a href={`/tracks/${a.id}/`} aria-current={a.id === track.id ? "page" : undefined}><span class="side-code">{a.code}</span> {a.title}</a></li>
          ))}
        </ol>
      </details>

      <div data-pagefind-ignore><TrackCover code={t.code} variant="banner" label={t.stage} /></div>

      <header class="head">
        <p class="eyebrow">{t.code} · {t.stage} · {position} of {all.length}</p>
        <h1>{t.title}</h1>
        <p class="lede">{t.summary}</p>
        <p class="status">
          {t.depth === "lesson" ? <span class="tag ok">Lesson</span> : <span class="tag">Reading list</span>}
          {t.verified ? (
            <span class="pill" data-checked={t.verified.toISOString()} data-state={freshness(t.verified.getTime())}>
              <span class="live-dot" />Checked against the live API · <b><time datetime={t.verified.toISOString().slice(0, 10)}>{verified}</time></b><span class="ago" data-ago />
            </span>
          ) : null}
          <button class="done-btn" type="button" data-done-toggle={track.id} aria-pressed="false" data-pagefind-ignore>
            <span class="tick"><svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2.6 6.3 5 8.6 9.6 3.6" /></svg></span>
            <span class="done-label">Mark as done</span>
          </button>
        </p>
        {changed.length > 0 && (
          <p class="source-note" data-pagefind-ignore>
            Since this was checked, the docs changed {changed.length === 1 ? "a page" : `${changed.length} pages`} it relies on:{" "}
            {changed.map((c, i) => (
              <>{i > 0 && (i === changed.length - 1 ? " and " : ", ")}<a href={c.url}>{c.title}</a></>
            ))}{" "}
            ({editDays}). Until it's re-checked, compare with {changed.length === 1 ? "that page" : "those pages"}; <a href="/changelog/">the changelog</a> lists every edit.
          </p>
        )}
      </header>

      <div class="reading">
        <section>
          <p class="eyebrow"><span class="n">01</span> Read first</p>
          <p class="muted">The official docs for this track.</p>
          <ul>
            {t.docs.map((d) => <li><a href={d.url}>{d.title}</a></li>)}
          </ul>
        </section>
        {t.outside.length > 0 && (
          <section>
            <p class="eyebrow"><span class="n">02</span> Then</p>
            <p class="muted">Tutorials and write-ups worth your time.</p>
            <ul>
              {t.outside.map((d) => (
                <li><a href={d.url}>{d.title}</a>{d.by && <span class="by">{d.by}</span>}</li>
              ))}
            </ul>
          </section>
        )}
        {t.build.length > 0 && (
          <section class="build">
            <p class="eyebrow"><span class="n">{t.outside.length > 0 ? "03" : "02"}</span> Build</p>
            <p class="muted">Hands-on work for this track.</p>
            <ul>
              {[...t.build].sort((a, b) => Number(a.status !== "live") - Number(b.status !== "live")).map((b) => (
                <li>
                  {b.href && b.status === "live" ? <a href={b.href}>{kindLabel[b.kind]}: {b.label}</a> : <span>{kindLabel[b.kind]}: {b.label}</span>}
                  {b.status === "planned" ? <span class="tag">Coming</span> : <span class="tag ok">Live</span>}
                </li>
              ))}
            </ul>
            {t.build.some((b) => b.status === "planned") && (
              <p class="muted" data-pagefind-ignore>Want one of these sooner? <a href="https://github.com/vignesh-chaturvedi/zerotohype/issues">Say so on GitHub</a>.</p>
            )}
          </section>
        )}
      </div>

      {sections.length > 2 && (
        <nav class="toc" aria-labelledby="toc-title" data-pagefind-ignore>
          <p class="eyebrow" id="toc-title">On this page · {minutes} min read</p>
          <ol>{sections.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </nav>
      )}

      <article class="prose">
        <Content />
      </article>

      {tryNext.length > 0 && (
        <aside class="try-next" aria-labelledby="try-title" data-pagefind-ignore>
          <p class="eyebrow" id="try-title">Now try it</p>
          {tryNext.map((b) => <a href={b.href}>{kindLabel[b.kind]}: {b.label} <span aria-hidden="true">→</span></a>)}
        </aside>
      )}

      <p class="edit" data-pagefind-ignore>
        Spot a mistake or something out of date?{" "}
        <a href={editUrl}>Edit this page on GitHub</a> or <a href="https://github.com/vignesh-chaturvedi/zerotohype/issues/new">open an issue</a>.
      </p>

      <nav class="pager" aria-label="Tracks" data-pagefind-ignore>
        {prev ? (
          <a href={`/tracks/${prev.id}/`} style={`--c: ${lookOf(prev.data.code).color}`}>
            <span class="eyebrow">← Previous</span>
            <span class="pager-title"><span class="swatch" />{prev.data.code} {prev.data.title}</span>
          </a>
        ) : <span />}
        {next ? (
          <a class="end" href={`/tracks/${next.id}/`} style={`--c: ${lookOf(next.data.code).color}`}>
            <span class="eyebrow">Next →</span>
            <span class="pager-title"><span class="swatch" />{next.data.code} {next.data.title}</span>
          </a>
        ) : <span />}
      </nav>
    </div>
  </div>
</Base>

<script>
  import "../../scripts/code-blocks.ts";
</script>

<style>
  .layout { display: grid; grid-template-columns: 250px minmax(0, 1fr); gap: 48px; align-items: start; }
  .main { display: grid; grid-template-columns: minmax(0, 1fr); gap: 32px; min-width: 0; }

  .side { position: sticky; top: 84px; display: grid; gap: 18px; max-height: calc(100vh - 110px); overflow-y: auto; padding-right: 6px; }
  .side-group { display: grid; gap: 6px; }
  .side-stage { font-size: 0.78125rem; font-weight: 600; color: var(--ink-2); }
  .side ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .side a {
    display: grid; grid-template-columns: 2.4rem minmax(0, 1fr) auto; gap: 8px; align-items: center;
    padding: 7px 10px; border-radius: 8px; text-decoration: none; color: var(--ink-2); font-size: 0.875rem; line-height: 1.3;
  }
  .side a:hover { background: var(--sunk); color: var(--ink); }
  .side a[aria-current="page"] { background: color-mix(in srgb, var(--c) calc(var(--cover-amt) * 0.6), var(--surface)); color: var(--ink); font-weight: 600; box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--c) 70%, var(--rule)); }
  .side-code { font: 400 0.75rem/1 var(--data); color: var(--muted); }
  .side-dot { width: 7px; height: 7px; border-radius: 50%; border: 1.5px solid var(--muted); }
  .side-dot.lesson { background: var(--ok); border-color: var(--ok); }
  /* What the two dots mean; screen readers get it from each link's name instead. */
  .side-key { display: flex; flex-wrap: wrap; gap: 4px 14px; margin-top: -8px; font-size: 0.75rem; color: var(--muted); }
  .side-key > span { display: inline-flex; align-items: center; gap: 6px; }
  .side-tick { display: none; width: 15px; height: 15px; border-radius: 50%; background: var(--ok); place-items: center; }
  .side-tick svg { width: 10px; height: 10px; fill: none; stroke: var(--bg); stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
  .side a:global(.is-done) .side-tick { display: grid; }
  .side a:global(.is-done) .side-dot { display: none; }

  .mobile-map { display: none; border: 1px solid var(--rule); border-radius: 10px; background: var(--surface); }
  .mobile-map summary { cursor: pointer; padding: 12px 16px; display: flex; gap: 10px; align-items: center; font-size: 0.875rem; color: var(--ink-2); }
  .mobile-map ol { list-style: none; margin: 0; padding: 4px 8px 10px; display: grid; gap: 2px; }
  .mobile-map a { display: block; padding: 8px 10px; border-radius: 9px; color: var(--ink-2); text-decoration: none; font-size: 0.90625rem; }
  .mobile-map a[aria-current="page"] { background: var(--sunk); color: var(--ink); font-weight: 600; }

  .head { display: grid; gap: 14px; }
  .head h1 { font-size: clamp(2.4rem, 5.6vw, 4.2rem); font-weight: 600; letter-spacing: -0.055em; line-height: 0.98; }
  .status { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  /* Shown when the changelog bot saw a cited docs page change after the lesson was checked. */
  .source-note {
    max-width: 72ch; margin: 0; padding: 10px 14px; border-radius: 12px; font-size: 0.875rem; line-height: 1.55; color: var(--ink-2);
    border: 1px solid color-mix(in srgb, var(--mvp) 45%, var(--rule)); background: color-mix(in srgb, var(--mvp) 9%, var(--surface));
  }

  .reading { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 14px; }
  .reading section { background: var(--surface); border: 1px solid var(--rule); border-radius: 12px; padding: 18px; display: grid; gap: 8px; align-content: start; min-width: 0; }
  .reading section.build { background: color-mix(in srgb, var(--c) calc(var(--cover-amt) * 0.35), var(--surface)); border-color: color-mix(in srgb, var(--c) 55%, var(--rule)); }
  .reading .eyebrow { display: flex; gap: 8px; align-items: center; color: var(--ink); }
  .reading .n { color: var(--muted); }
  .reading p.muted { font-size: 0.84375rem; }
  .reading ul { list-style: none; padding: 0; margin: 4px 0 0; display: grid; gap: 9px; font-size: 0.90625rem; line-height: 1.45; }
  .reading li { overflow-wrap: anywhere; display: flex; flex-wrap: wrap; gap: 4px 8px; align-items: baseline; }
  .by { color: var(--muted); font-size: 0.78125rem; }

  /* Contents of a lesson, above it */
  .toc { display: grid; gap: 10px; max-width: 70ch; padding: 16px 18px; border: 1px solid var(--rule); border-radius: 12px; background: var(--surface); }
  .toc ol { margin: 0; padding-left: 1.4em; columns: 2 16rem; column-gap: 28px; font-size: 0.9375rem; line-height: 1.5; }
  .toc li { break-inside: avoid; padding: 3px 0; }
  .toc li::marker { color: var(--muted); font: 500 0.75rem var(--data); }
  /* What to do once the lesson is read */
  .try-next { display: grid; gap: 10px; max-width: 70ch; padding: 18px; border-radius: 12px; border: 1px solid color-mix(in srgb, var(--c) 55%, var(--rule)); background: color-mix(in srgb, var(--c) calc(var(--cover-amt) * 0.35), var(--surface)); }
  .try-next a { font: 600 1.05rem/1.3 var(--display); letter-spacing: -0.01em; }
  .edit { max-width: 70ch; font-size: 0.875rem; color: var(--muted); }
  .pager { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; padding-top: 12px; }
  .pager a { display: grid; gap: 8px; padding: 18px; border: 1px solid var(--rule); border-radius: 12px; background: var(--surface); text-decoration: none; color: var(--ink); transition: transform 200ms var(--ease), box-shadow 200ms var(--ease); }
  .pager a:hover { transform: translateY(-2px); box-shadow: var(--shadow-lift); }
  .pager a.end { text-align: right; justify-items: end; }
  .pager-title { display: inline-flex; align-items: center; gap: 10px; font: 600 1.1rem/1.2 var(--display); letter-spacing: -0.02em; }
  .swatch { width: 14px; height: 14px; border-radius: 4px; background: color-mix(in srgb, var(--c) var(--cover-amt), var(--surface)); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--ink) 15%, transparent); flex: none; }

  @media (max-width: 980px) {
    .layout { grid-template-columns: minmax(0, 1fr); }
    .side { display: none; }
    .mobile-map { display: block; }
  }
  @media (max-width: 560px) { .pager { grid-template-columns: minmax(0, 1fr); } .pager a.end { text-align: left; justify-items: start; } }
</style>
